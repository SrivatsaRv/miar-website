---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SensorStack from "../components/SensorStack.astro";
import SceneField from "../components/SceneField.astro";
import ModesConsole from "../components/ModesConsole.astro";
import ChangeCompare from "../components/ChangeCompare.astro";
import WorkflowDiagram from "../components/WorkflowDiagram.astro";
import SensorMatrix from "../components/SensorMatrix.astro";
import EvidenceRecord from "../components/EvidenceRecord.astro";
import IntelligenceContract from "../components/IntelligenceContract.astro";
import RequestForm from "../components/RequestForm.astro";
import TaxonomyDrill from "../components/TaxonomyDrill.astro";
import FragmentationFlow from "../components/FragmentationFlow.astro";
import ProcessingRail from "../components/ProcessingRail.astro";
import { solutions } from "../data/solutions";

const latest = (await getCollection("blog"))
  .filter((post) => post.data.status === "published")
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())[0];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" }).format(date);

const users = [
  {
    role: "Imagery analysts",
    unit: "IMINT and GEOINT cells",
    need: "Spend the day on what changed, not on finding and lining up images.",
  },
  {
    role: "Collection managers",
    unit: "Tasking and requirements",
    need: "See which places changed and where to point the satellites next.",
  },
  {
    role: "Operational picture teams",
    unit: "ORBAT and all-source",
    need: "Get confirmed changes in strength and position, with the evidence attached.",
  },
  {
    role: "Air defence and force protection",
    unit: "Heightened awareness",
    need: "Get an alert when a threat to the bases you protect appears across the border.",
  },
  {
    role: "Programme owners",
    unit: "Ground segment and integration",
    need: "Run one processing layer behind every imagery provider, instead of one tool each.",
  },
];
---

<BaseLayout
  title="MIAR | The unified intelligence processing layer for the modern battlefield"
  description="MIAR turns satellite imagery from every provider and every sensor into what changed at every installation you watch, as fast as the imagery lands."
  current="home"
>
  <main>
    <SceneField />

    <section class="facts-band on-night" aria-label="At a glance">
      <div class="wrap">
        <ul class="hero-facts">
          <li><strong>Any provider</strong>Commercial, national or public satellites</li>
          <li><strong>Every sensor</strong>Optical, radar, hyperspectral and thermal</li>
          <li><strong>Built for scale</strong>From one airbase to the whole battlefield</li>
          <li><strong>Runs on your ground</strong>Inside your own network, even offline</li>
        </ul>
      </div>
    </section>

    <section class="section" id="overview">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">01</span> The problem</span>
          <div class="section-head-body">
            <h2>Satellites now collect more than people can read.</h2>
            <p class="lead">
              Imagery arrives from many providers, in different formats, into different tools. Every new image means starting over, and the question that matters most, what this means for us, gets answered last.
            </p>
          </div>
        </div>
        <div class="problem-grid">
          <article>
            <span class="num">01</span>
            <h3>Scattered</h3>
            <p>Images sit in separate provider portals and storage, each in its own format.</p>
          </article>
          <article>
            <span class="num">02</span>
            <h3>Starting over</h3>
            <p>Each new image is compared with the previous one by hand before anything can be said about it.</p>
          </article>
          <article>
            <span class="num">03</span>
            <h3>Growing faster than teams</h3>
            <p>More satellites and more passes every year, read by the same number of people.</p>
          </article>
          <article>
            <span class="num">04</span>
            <h3>Slow to act</h3>
            <p>By the time a change is spotted and explained, the moment to act on it may have passed.</p>
          </article>
        </div>
        <p class="gap-close">MIAR is built for the part after the image arrives: making sense of all of it, as fast as it comes in.</p>
      </div>
    </section>

    <section class="section" id="how-it-works">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">02</span> How it works</span>
          <div class="section-head-body">
            <h2>Five steps, from new image to usable intelligence.</h2>
            <p class="lead">
              MIAR does the lining up, spotting, comparing and assessing automatically, and keeps a record of every step.
            </p>
          </div>
        </div>
        <WorkflowDiagram />
        <div class="flow-foot">
          <p>The same process runs for one airbase or a whole battlefield, whichever satellites you buy from.</p>
          <a class="text-link" href="/capabilities/">Explore the workflow <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section" data-stage="0" data-status="Scenes received from five providers">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">03</span> Where MIAR sits <span class="stage-tag" aria-label="Pipeline stage 1 of 5, Receive"><i>1/5</i>Receive</span></span>
          <div class="section-head-body">
            <h2>You buy the imagery. MIAR does the rest.</h2>
            <p class="lead">
              Keep your satellite providers, storage and maps. MIAR plugs in behind them as one unified intelligence processing layer, and turns every image, from every source, into the same kind of answer.
            </p>
          </div>
        </div>
        <FragmentationFlow />
        <p class="formats"><span>Imagery</span> GeoTIFF / COG · NITF · JPEG 2000 · STAC <span>Basemaps</span> ArcGIS · WMS / WMTS · XYZ <span>Layers</span> GeoJSON · KML · GeoPackage · OGC API</p>
      </div>
    </section>

    <section class="section" data-stage="1" data-status="Co-registered EO, SAR and HSI to Site 014">
      <div class="wrap matrix-layout">
        <div class="matrix-intro">
          <span class="label"><span class="label-index">04</span> Every sensor, one record <span class="stage-tag" aria-label="Pipeline stage 2 of 5, Register"><i>2/5</i>Register</span></span>
          <h2>Works when the weather doesn't.</h2>
          <p>
            Ordinary cameras can't see through cloud or at night. Radar can. Hyperspectral sensors can
            tell real equipment from a decoy. MIAR combines all of them, so a cloudy week never leaves a
            gap in the picture.
          </p>
        </div>
        <div>
          <SensorMatrix />
        </div>
      </div>
    </section>

    <section class="section" data-stage="2" data-status="Classified · fighter, transport, rotary">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">05</span> Detection models <span class="stage-tag" aria-label="Pipeline stage 3 of 5, Exploit, Detect"><i>3/5</i>Exploit · Detect</span></span>
          <div class="section-head-body">
            <h2>Trained to recognise military equipment from space.</h2>
            <p class="lead">
              MIAR's models are trained on satellite images of military sites, so they recognise aircraft and ships down to their exact type and say how sure they are. Click through the breakdown below to see how each detection is classified.
            </p>
          </div>
        </div>
        <div class="detectors">
          <article>
            <div class="detector-top"><span class="detector-status is-live">Available</span><span class="num">D-01</span></div>
            <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M32 6l3 10v12l22 9v5l-22-5v12l7 6v3l-10-2-10 2v-3l7-6V37l-22 5v-5l22-9V16z"/></svg>
            <h3>Aircraft</h3>
            <p>Fighters, transports, tankers, patrol aircraft and helicopters, down to the type.</p>
            <span class="detector-meta">EO · SAR · oriented boxes</span>
          </article>
          <article>
            <div class="detector-top"><span class="detector-status is-live">Available</span><span class="num">D-02</span></div>
            <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M32 4l8 14v34l-8 8-8-8V18z"/><path d="M28 24h8M28 32h8M28 40h8"/></svg>
            <h3>Ships</h3>
            <p>Warships, submarines and commercial vessels, in port or at sea, by class and size.</p>
            <span class="detector-meta">EO · SAR · oriented boxes</span>
          </article>
          <article class="is-soon">
            <div class="detector-top"><span class="detector-status">Coming soon</span><span class="num">D-03</span></div>
            <svg viewBox="0 0 64 64" aria-hidden="true"><rect x="12" y="22" width="40" height="22" rx="3"/><rect x="24" y="14" width="16" height="10"/><path d="M40 18h18"/><circle cx="20" cy="48" r="4"/><circle cx="32" cy="48" r="4"/><circle cx="44" cy="48" r="4"/></svg>
            <h3>Armed forces vehicles</h3>
            <p>Tanks, artillery, air-defence and logistics vehicles at garrisons and depots.</p>
            <span class="detector-meta">In development</span>
          </article>
        </div>
        <TaxonomyDrill />
      </div>
    </section>

    <section class="section" data-stage="2" data-status="6 aircraft · 3 in new positions">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">06</span> Same airbase, one year apart <span class="stage-tag" aria-label="Pipeline stage 3 of 5, Exploit, Compare"><i>3/5</i>Exploit · Compare</span></span>
          <div class="section-head-body">
            <h2>Six aircraft in both images. Half of them have moved.</h2>
            <p class="lead">
              A simple count would say nothing changed. MIAR tracks where each aircraft stands, so it catches the reshuffle: three aircraft moved, one of them onto the taxiway, and a helicopter arrived.
            </p>
          </div>
        </div>
        <ChangeCompare id="home-compare" />
        <p class="figure-note">Drag across the image to compare. Imagery of a monitored airbase, 2025 and 2026, with identifying details removed.</p>
      </div>
    </section>

    <section class="section" id="posture" data-stage="2" data-status="Assessed against protected assets · HIGH">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">07</span> From detection to posture <span class="stage-tag" aria-label="Pipeline stage 3 of 5, Exploit, Assess"><i>3/5</i>Exploit · Assess</span></span>
          <div class="section-head-body">
            <h2>You've detected four fighters. Now what?</h2>
            <p class="lead">
              Spotting aircraft is only the start. MIAR knows what each type can do and how far it can reach, so it tells you what the change means for the places you protect, and flags the ones in range.
            </p>
          </div>
        </div>
        <div class="posture-why">
          <div>
            <span class="label">Same apron, different meaning</span>
            <p>A <strong>transport aircraft</strong> at a border airbase usually means cargo or troops on the move.</p>
          </div>
          <div>
            <span class="label">Same apron, different meaning</span>
            <p>A <strong>fighter</strong> at the same airbase means strike capability, with your bases within reach.</p>
          </div>
          <div>
            <span class="label">What MIAR adds</span>
            <p>The aircraft, what it can do, and what that means for you, in one alert.</p>
          </div>
        </div>
        <ModesConsole />
        <p class="figure-note">Choose how MIAR watches: from routine detection to heightened awareness during a crisis.</p>
      </div>
    </section>

    <section class="section on-night try-it" id="try-it" data-stage="3" data-status="Candidates in front of the analyst">
      <div class="wrap try-grid">
        <div class="section-head-body">
          <span class="label"><span class="label-index">08</span> Try it yourself <span class="stage-tag" aria-label="Pipeline stage 4 of 5, Qualify, Decide"><i>4/5</i>Qualify · Decide</span></span>
          <h2>Three sensors, one answer. Try it.</h2>
          <p class="lead">
              Pick a detection and see what the camera, the radar and the hyperspectral sensor each saw at that spot. When they disagree, you've probably found a decoy.
            </p>
          <ul class="try-hints">
            <li><span>C-3</span>The camera sees an aircraft. Radar and hyperspectral don't. Likely a decoy.</li>
            <li><span>C-4</span>The camera sees nothing. Radar and hyperspectral find a hidden vehicle.</li>
            <li><span>Hover</span>Over a sensor reading to see just that layer.</li>
          </ul>
        </div>
        <div class="try-visual">
          <SensorStack />
        </div>
      </div>
    </section>

    <section class="section" data-stage="3" data-status="Qualified by analyst 07">
      <div class="wrap record-layout">
        <EvidenceRecord />
        <div class="section-head-body">
          <span class="label"><span class="label-index">09</span> Evidence <span class="stage-tag" aria-label="Pipeline stage 4 of 5, Qualify, Record"><i>4/5</i>Qualify · Record</span></span>
          <h2>Every finding shows its proof.</h2>
          <p class="lead">Whoever receives a finding can see exactly where it came from and how it was reached.</p>
          <ol class="record-notes">
            <li><span class="pin" aria-hidden="true">1</span><div><strong>The images</strong><p>The new image and the earlier one it was compared with.</p></div></li>
            <li><span class="pin" aria-hidden="true">2</span><div><strong>The confidence</strong><p>What was found, down to the type, and how sure the model is.</p></div></li>
            <li><span class="pin" aria-hidden="true">3</span><div><strong>The decision</strong><p>Who confirmed the finding, when, and with what note.</p></div></li>
            <li><span class="pin" aria-hidden="true">4</span><div><strong>The history</strong><p>Every step from the image arriving to the report going out.</p></div></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section" data-stage="4" data-status="Published · contract F-0152">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">10</span> The output <span class="stage-tag" aria-label="Pipeline stage 5 of 5, Publish"><i>5/5</i>Publish</span></span>
          <div class="section-head-body">
            <h2>Every change becomes intelligence other systems can use.</h2>
            <p class="lead">
              MIAR packages each change as an intelligence contract: what was seen, how many, what changed, how sure, and where it came from, in a format maps, dashboards and command systems read directly.
            </p>
          </div>
        </div>
        <IntelligenceContract animated />
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">11</span> Who it's for</span>
          <div class="section-head-body">
            <h2>Built for the teams who watch the battlefield.</h2>
          </div>
        </div>
        <div class="users">
          {users.map((user) => (
            <article>
              <span class="label">{user.unit}</span>
              <h3>{user.role}</h3>
              <p>{user.need}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">12</span> Use cases</span>
          <div class="section-head-body">
            <h2>Built around the questions defence teams ask.</h2>
          </div>
        </div>
        <div class="cases">
          {solutions.map((solution) => (
            <a class="case-row" href={`/solutions/${solution.slug}/`}>
              <span class="num">{solution.number}</span>
              <h3>{solution.name}</h3>
              <p class="case-q">{solution.question}</p>
              <span class="case-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section on-night">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">13</span> Your ground, your control</span>
          <div class="section-head-body">
            <h2>Runs on your ground, under your control.</h2>
            <p class="lead">
              MIAR can run entirely inside your own network, even disconnected from the internet. Your imagery, models and findings never leave it.
            </p>
          </div>
        </div>
        <div class="sovereign">
          <div><strong>Imagery</strong>remains local</div>
          <div><strong>Detectors</strong>run locally</div>
          <div><strong>Findings</strong>stay yours</div>
          <div><strong>Evidence</strong>remains traceable</div>
        </div>
        <div class="pillars">
          <article>
            <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="8" cy="9" r="3"/><circle cx="8" cy="18" r="3"/><circle cx="8" cy="27" r="3"/><path d="M11 9c7 0 7 9 14 9M11 27c7 0 7-9 14-9M11 18h14"/><rect x="25" y="14" width="8" height="8"/></svg>
            <h3>Provider-agnostic</h3>
            <p>Commercial, national and public satellites such as Sentinel and Landsat, all in one place.</p>
          </article>
          <article>
            <svg viewBox="0 0 36 36" aria-hidden="true"><path d="M18 3l12 5v9c0 8-5 13-12 16C11 30 6 25 6 17V8z"/><rect x="13" y="15" width="10" height="8"/><path d="M15 15v-3a3 3 0 016 0v3"/></svg>
            <h3>Connect, don't duplicate</h3>
            <p>Works with the maps and command systems you already use, through open standards.</p>
          </article>
          <article>
            <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="11" r="6"/><path d="M6 33c0-7 5-11 12-11s12 4 12 11"/><path d="M13 27l3.5 3.5L24 24"/></svg>
            <h3>Built to scale</h3>
            <p>From one airbase to thousands of locations across the battlefield, on the same layer.</p>
          </article>
        </div>
      </div>
    </section>

    {latest && (
      <section class="section section-tight">
        <div class="wrap">
          <div class="section-head" style="margin-bottom: 40px">
            <span class="label"><span class="label-index">14</span> Insights</span>
            <div class="section-head-body insights-head">
              <h2>From the ReachDefence team.</h2>
              <a class="text-link" href="/blogs/">All articles <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <a class="insight-feature" href={`/blogs/posts/${latest.id}/`}>
            <div class="insight-feature-image">
              <img src={latest.data.gallery.at(-1)?.src ?? latest.data.heroImage} alt={latest.data.gallery.at(-1)?.alt ?? latest.data.heroImageAlt} width={latest.data.gallery.at(-1)?.width ?? latest.data.heroImageWidth} height={latest.data.gallery.at(-1)?.height ?? latest.data.heroImageHeight} loading="lazy" decoding="async" />
            </div>
            <div class="insight-feature-copy">
              <div class="meta-row">
                <span>{latest.data.category}</span>
                <time datetime={latest.data.publishedAt.toISOString()}>{formatDate(latest.data.publishedAt)}</time>
                <span>{latest.data.readingMinutes} min read</span>
              </div>
              <h3>{latest.data.title}</h3>
              <p>{latest.data.summary}</p>
              <span class="text-link">Read the article <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </div>
      </section>
    )}

    <section class="section" id="waitlist">
      <div class="wrap request">
        <div class="request-copy">
          <span class="label"><span class="label-index">15</span> Request access</span>
          <h2>See it on your own imagery.</h2>
          <p>
            MIAR is available to defence and government teams, research groups and programme offices.
            Tell us what you watch and where your imagery comes from, and we'll come back to you.
          </p>
          <ol class="next-steps">
            <li><span class="num">01</span><div><strong>We review your request</strong><p>Every request is checked for fit and eligibility.</p></div></li>
            <li><span class="num">02</span><div><strong>A short call</strong><p>We talk through what you watch and the imagery you use today.</p></div></li>
            <li><span class="num">03</span><div><strong>A trial on real data</strong><p>An evaluation on your own imagery or public data, inside your environment.</p></div></li>
          </ol>
          <p class="request-note">
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8"/><path d="M10 6v5M10 13.5v.5"/></svg>
            Please don't include classified, export-controlled or operationally sensitive information in this form.
          </p>
        </div>
        <RequestForm />
      </div>
    </section>
  </main>
  <ProcessingRail />
</BaseLayout>
