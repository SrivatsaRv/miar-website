---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SensorStack from "../components/SensorStack.astro";
import ChangeCompare from "../components/ChangeCompare.astro";
import WorkflowDiagram from "../components/WorkflowDiagram.astro";
import SensorMatrix from "../components/SensorMatrix.astro";
import EvidenceRecord from "../components/EvidenceRecord.astro";
import RequestForm from "../components/RequestForm.astro";
import { solutions } from "../data/solutions";

const latest = (await getCollection("blog"))
  .filter((post) => post.data.status === "published")
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())[0];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" }).format(date);
---

<BaseLayout
  title="MIAR | Know what changed at every site you watch"
  description="MIAR compares new satellite imagery with each site's history, shows analysts what changed, and keeps the evidence behind every finding they approve."
  current="home"
>
  <main>
    <section class="hero on-night" id="home">
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="hero-content wrap">
        <div class="hero-copy">
          <span class="label">Imagery intelligence for defence analysts</span>
          <h1 class="display">Know what changed at every site you watch.</h1>
          <p class="lead">
            MIAR reads optical, radar and hyperspectral imagery of the same site, compares it with
            the site's history, and gives your analysts one finding, with the evidence from every
            sensor attached.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#waitlist">Request access <span class="arrow" aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="#how-it-works">See how it works</a>
          </div>
        </div>
        <div class="hero-visual">
          <p class="hero-hint"><span></span>Try it: you're the analyst on this pass</p>
          <SensorStack />
        </div>
      </div>

      <div class="wrap">
        <ul class="hero-facts" aria-label="At a glance">
          <li><strong>Any imagery provider</strong>Commercial or national</li>
          <li><strong>EO · SAR · HSI · IR</strong>Every major sensor type</li>
          <li><strong>Analyst sign-off</strong>On every reported finding</li>
          <li><strong>Your environment</strong>Sovereign and on-premise options</li>
        </ul>
      </div>
    </section>

    <section class="section" id="overview">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">01</span> The problem</span>
          <div class="section-head-body">
            <h2>A new image shows what is there. It doesn't tell you what changed.</h2>
          </div>
        </div>
        <div class="problem-grid">
          <article>
            <span class="num">A</span>
            <h3>More images than analysts</h3>
            <p>Revisit rates keep rising while analyst hours don't. Every new pass competes for the same limited attention.</p>
          </article>
          <article>
            <span class="num">B</span>
            <h3>Change needs a baseline</h3>
            <p>Cloud, shadow, season and viewing angle all look like change. Without the site's history, analysts sort that noise by hand.</p>
          </article>
          <article>
            <span class="num">C</span>
            <h3>Findings lose their proof</h3>
            <p>By the time a finding reaches a brief, the image, the comparison and the analyst's reasoning have usually been left behind.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">02</span> Same site, one year apart</span>
          <div class="section-head-body">
            <h2>Six aircraft in both images. Half of them have moved.</h2>
            <p class="lead">
              A simple count would report no change. MIAR compares where each aircraft stands, so the
              analyst sees that the apron has been reorganised, one aircraft is on the taxiway and a
              helicopter has arrived.
            </p>
          </div>
        </div>
        <ChangeCompare id="home-compare" />
        <p class="figure-note">Drag across the image to compare. Imagery of a monitored airbase, 2025 and 2026, with identifying details removed.</p>
      </div>
    </section>

    <section class="section" id="how-it-works">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">03</span> How it works</span>
          <div class="section-head-body">
            <h2>From new image to signed-off finding, in five steps.</h2>
            <p class="lead">
              Software does the searching and comparing. Analysts make the decisions. Every step is
              recorded.
            </p>
          </div>
        </div>
        <WorkflowDiagram />
        <div class="flow-foot">
          <p>The same process works for a single site or a watchlist of hundreds, whichever providers you buy imagery from.</p>
          <a class="text-link" href="/capabilities/">Explore the workflow <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap matrix-layout">
        <div class="matrix-intro">
          <span class="label"><span class="label-index">04</span> Every sensor, one record</span>
          <h2>Works when the weather doesn't.</h2>
          <p>
            No single sensor sees everything. Optical shows shape, radar sees through cloud and at night,
            hyperspectral shows what things are made of. MIAR puts them in the same site record, so
            a cloudy week or a decoy doesn't leave a gap in the picture.
          </p>
        </div>
        <div>
          <SensorMatrix />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap record-layout">
        <EvidenceRecord />
        <div class="section-head-body">
          <span class="label"><span class="label-index">05</span> Evidence</span>
          <h2>Every finding keeps its evidence.</h2>
          <p class="lead">When a finding reaches a commander, a partner or an auditor, the proof travels with it.</p>
          <ol class="record-notes">
            <li><span class="pin" aria-hidden="true">1</span><div><strong>The source imagery</strong><p>The current image and the baseline it was compared with, exactly as the analyst saw them.</p></div></li>
            <li><span class="pin" aria-hidden="true">2</span><div><strong>The model's confidence</strong><p>What was detected and how certain the model was. Shown in full, never rounded into a yes or no.</p></div></li>
            <li><span class="pin" aria-hidden="true">3</span><div><strong>The analyst's decision</strong><p>Who accepted or rejected the finding, and why. Nothing is reported without it.</p></div></li>
            <li><span class="pin" aria-hidden="true">4</span><div><strong>The full history</strong><p>Every step from image receipt to brief, so anyone relying on the finding can check it.</p></div></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">06</span> Use cases</span>
          <div class="section-head-body">
            <h2>Built around the questions analysts are actually asked.</h2>
          </div>
        </div>
        <div class="cases">
          {solutions.map((solution) => (
            <a class="case-row" href={`/solutions/${solution.slug}/`}>
              <span class="num">{solution.number}</span>
              <h3>{solution.name}</h3>
              <p class="case-q">{solution.question}</p>
              <span class="case-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section on-night">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">07</span> Control</span>
          <div class="section-head-body">
            <h2>Your imagery. Your models. Your authority.</h2>
            <p class="lead">
              MIAR sits between your imagery suppliers and the people who act on the results. It
              doesn't own your collection, and it never makes the final call.
            </p>
          </div>
        </div>
        <div class="pillars">
          <article>
            <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="8" cy="9" r="3"/><circle cx="8" cy="18" r="3"/><circle cx="8" cy="27" r="3"/><path d="M11 9c7 0 7 9 14 9M11 27c7 0 7-9 14-9M11 18h14"/><rect x="25" y="14" width="8" height="8"/></svg>
            <h3>Provider-neutral</h3>
            <p>Use imagery from any commercial or national source. Change suppliers without changing how your analysts work.</p>
          </article>
          <article>
            <svg viewBox="0 0 36 36" aria-hidden="true"><path d="M18 3l12 5v9c0 8-5 13-12 16C11 30 6 25 6 17V8z"/><rect x="13" y="15" width="10" height="8"/><path d="M15 15v-3a3 3 0 016 0v3"/></svg>
            <h3>Deploy where you need it</h3>
            <p>Run in a controlled, on-premise or sovereign environment, so imagery and findings stay inside your boundary.</p>
          </article>
          <article>
            <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="11" r="6"/><path d="M6 33c0-7 5-11 12-11s12 4 12 11"/><path d="M13 27l3.5 3.5L24 24"/></svg>
            <h3>People make the call</h3>
            <p>Model output stays a suggestion until an analyst approves it. Every decision is logged against a named reviewer.</p>
          </article>
        </div>
      </div>
    </section>

    {latest && (
      <section class="section section-tight">
        <div class="wrap">
          <div class="section-head" style="margin-bottom: 40px">
            <span class="label"><span class="label-index">08</span> Insights</span>
            <div class="section-head-body" style="grid-template-columns: 1fr auto; align-items: end; max-width: none">
              <h2>From the ReachDefence team.</h2>
              <a class="text-link" href="/blogs/">All articles <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <a class="insight-feature" href={`/blogs/posts/${latest.id}/`}>
            <div class="insight-feature-image">
              <img src={latest.data.gallery.at(-1)?.src ?? latest.data.heroImage} alt={latest.data.gallery.at(-1)?.alt ?? latest.data.heroImageAlt} width={latest.data.gallery.at(-1)?.width ?? latest.data.heroImageWidth} height={latest.data.gallery.at(-1)?.height ?? latest.data.heroImageHeight} loading="lazy" decoding="async" />
            </div>
            <div class="insight-feature-copy">
              <div class="meta-row">
                <span>{latest.data.category}</span>
                <time datetime={latest.data.publishedAt.toISOString()}>{formatDate(latest.data.publishedAt)}</time>
                <span>{latest.data.readingMinutes} min read</span>
              </div>
              <h3>{latest.data.title}</h3>
              <p>{latest.data.summary}</p>
              <span class="text-link">Read the article <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </div>
      </section>
    )}

    <section class="section" id="waitlist">
      <div class="wrap request">
        <div class="request-copy">
          <span class="label"><span class="label-index">09</span> Request access</span>
          <h2>Tell us what you need to watch.</h2>
          <p>
            MIAR is available to defence and government analysts, geospatial intelligence teams,
            research groups and programme teams. Tell us about your sites and imagery, and we'll
            come back to you directly.
          </p>
          <ol class="next-steps">
            <li><span class="num">01</span><div><strong>We review your request</strong><p>Every request is checked for fit and eligibility.</p></div></li>
            <li><span class="num">02</span><div><strong>A short call</strong><p>If there's a match, we talk through your sites, sources and current workflow.</p></div></li>
            <li><span class="num">03</span><div><strong>A scoped evaluation</strong><p>Together we agree an evaluation built around your use case.</p></div></li>
          </ol>
          <p class="request-note">
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8"/><path d="M10 6v5M10 13.5v.5"/></svg>
            Please don't include classified, export-controlled or operationally sensitive information in this form.
          </p>
        </div>
        <RequestForm />
      </div>
    </section>
  </main>
</BaseLayout>
