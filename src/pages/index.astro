---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import SensorStack from "../components/SensorStack.astro";
import ChangeCompare from "../components/ChangeCompare.astro";
import WorkflowDiagram from "../components/WorkflowDiagram.astro";
import SensorMatrix from "../components/SensorMatrix.astro";
import EvidenceRecord from "../components/EvidenceRecord.astro";
import IntelligenceContract from "../components/IntelligenceContract.astro";
import RequestForm from "../components/RequestForm.astro";
import TaxonomyDrill from "../components/TaxonomyDrill.astro";
import { solutions } from "../data/solutions";

const latest = (await getCollection("blog"))
  .filter((post) => post.data.status === "published")
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())[0];

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "long", year: "numeric" }).format(date);

const users = [
  {
    role: "Imagery analysts",
    unit: "IMINT and GEOINT cells",
    need: "Exploit every new scene against the site's history, qualify findings and publish them without rebuilding context.",
  },
  {
    role: "Collection managers",
    unit: "Tasking and requirements",
    need: "See which sites changed, which scenes were unusable, and where the next EO or SAR collection should go.",
  },
  {
    role: "All-source and ORBAT teams",
    unit: "Operational picture owners",
    need: "Receive qualified changes to strength and disposition, with the imagery and analyst decision attached.",
  },
  {
    role: "Programme and platform owners",
    unit: "Ground segment and integration",
    need: "Put one exploitation layer behind several imagery providers, instead of one tool per provider.",
  },
];
---

<BaseLayout
  title="MIAR | Know what changed at every site you watch"
  description="MIAR is the post-reception exploitation layer for defence imagery: register scenes from any provider, detect and compare against site history, qualify with an analyst, and publish a governed change to the operational picture."
  current="home"
>
  <main>
    <section class="hero on-night" id="home">
      <div class="hero-grid-bg" aria-hidden="true"></div>
      <div class="hero-content wrap">
        <div class="hero-copy">
          <span class="label">Post-reception imagery exploitation</span>
          <h1 class="display">Know what changed at every site you watch.</h1>
          <p class="lead">
            Your focus is obtaining imagery. MIAR does everything after reception: every EO, SAR and
            hyperspectral scene is co-registered to the site's history, exploited by purpose-trained
            detection models, and qualified by an analyst before it updates the picture.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#waitlist">Request access <span class="arrow" aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="#how-it-works">See how it works</a>
          </div>
        </div>
        <div class="hero-visual">
          <p class="hero-hint"><span></span>Try it: qualify this pass as the imagery analyst</p>
          <SensorStack />
        </div>
      </div>

      <div class="wrap">
        <ul class="hero-facts" aria-label="At a glance">
          <li><strong>Provider-agnostic</strong>Tasked, archive or national scenes</li>
          <li><strong>EO · SAR · HSI · IR</strong>One site record across sensors</li>
          <li><strong>Analyst-qualified</strong>Nothing published without sign-off</li>
          <li><strong>Sovereign</strong>Runs inside your boundary, disconnected</li>
        </ul>
      </div>
    </section>

    <section class="section" id="overview">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">01</span> The operational gap</span>
          <div class="section-head-body">
            <h2>A new scene arrives. Your team shouldn't have to start from zero.</h2>
            <p class="lead">Today each pass restarts the same cycle across separate tools. Work done on the last scene rarely carries into the next.</p>
          </div>
        </div>
        <div class="problem-grid">
          <article>
            <span class="num">01</span>
            <h3>Find the scene</h3>
            <p>Locate the pass across provider portals and storage, then establish whether it's usable: cloud, look angle, GSD.</p>
          </article>
          <article>
            <span class="num">02</span>
            <h3>Rebuild context</h3>
            <p>Recover the site's history, installation layout, ORBAT and the last analyst judgement, usually from different systems.</p>
          </article>
          <article>
            <span class="num">03</span>
            <h3>Reassess</h3>
            <p>Repeat the count and comparison by hand before anything can be trusted, and repeat it again for the next scene.</p>
          </article>
        </div>
        <p class="gap-close">The problem isn't access to imagery. It's the loss of context and decision continuity between scenes.</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">02</span> Where MIAR sits</span>
          <div class="section-head-body">
            <h2>You focus on obtaining imagery. MIAR does the rest.</h2>
            <p class="lead">
              Keep tasking with the providers you already use, and keep storage and GIS where they
              are. MIAR is the single exploitation layer after reception. It connects to that
              infrastructure rather than duplicating it, and turns every received scene into the
              same qualified output.
            </p>
          </div>
        </div>
        <div class="position">
          <div class="position-col">
            <span class="label">Upstream · you keep</span>
            <ul>
              <li>Provider tasking and ordering portals</li>
              <li>Ground segment and reception</li>
              <li>Archive and licensed catalogues</li>
              <li>Basemaps, ORBAT and identity</li>
            </ul>
          </div>
          <div class="position-core">
            <span class="label">MIAR</span>
            <ol>
              <li><strong>Register</strong>Orthorectify and co-register to the site baseline</li>
              <li><strong>Exploit</strong>Detect, classify, compare, correlate</li>
              <li><strong>Qualify</strong>Analyst accepts, rejects or annotates</li>
              <li><strong>Publish</strong>Governed intelligence contract</li>
            </ol>
          </div>
          <div class="position-col">
            <span class="label">Downstream · you gain</span>
            <ul>
              <li>ORBAT and operational picture systems</li>
              <li>GIS and feature services</li>
              <li>Briefing and reporting</li>
              <li>Collection management and cueing</li>
            </ul>
          </div>
        </div>
        <p class="formats"><span>Imagery</span> GeoTIFF / COG · NITF · JPEG 2000 · STAC <span>Basemaps</span> ArcGIS · WMS / WMTS · XYZ <span>Layers</span> GeoJSON · KML · GeoPackage · OGC API</p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">03</span> Same site, one year apart</span>
          <div class="section-head-body">
            <h2>Six aircraft in both scenes. Half of them have moved.</h2>
            <p class="lead">
              A count alone would report no change. MIAR compares the position of every detected
              aircraft against the baseline, so the analyst sees the apron has been reorganised, one
              aircraft is on the taxiway and a rotary-wing aircraft has arrived.
            </p>
          </div>
        </div>
        <ChangeCompare id="home-compare" />
        <p class="figure-note">Drag across the scene to compare. Imagery of a monitored airbase, 2025 and 2026, with identifying details removed.</p>
      </div>
    </section>

    <section class="section" id="how-it-works">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">04</span> How it works</span>
          <div class="section-head-body">
            <h2>From received scene to qualified finding, in five steps.</h2>
            <p class="lead">
              Automated exploitation does the searching and comparing. Analysts qualify every
              finding. Every step is recorded against the scene it came from.
            </p>
          </div>
        </div>
        <WorkflowDiagram />
        <div class="flow-foot">
          <p>The same thread runs for one installation or a watchlist of hundreds, and for every provider you buy from.</p>
          <a class="text-link" href="/capabilities/">Explore the workflow <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">05</span> Detection models</span>
          <div class="section-head-body">
            <h2>Purpose-trained for military targets, not repurposed from street photos.</h2>
            <p class="lead">
              Overhead imagery is a different problem from everyday computer vision. MIAR's ML models
              are trained specifically on satellite scenes of military targets, with oriented
              detections and a role, type and state hierarchy that analysts can check. Select any
              level below to drill in.
            </p>
          </div>
        </div>
        <div class="detectors">
          <article>
            <div class="detector-top"><span class="detector-status is-live">Available</span><span class="num">D-01</span></div>
            <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M32 6l3 10v12l22 9v5l-22-5v12l7 6v3l-10-2-10 2v-3l7-6V37l-22 5v-5l22-9V16z"/></svg>
            <h3>Aircraft</h3>
            <p>Fixed and rotary wing, recognised down to family and type: fighter, transport, tanker, patrol, helicopter.</p>
            <span class="detector-meta">EO · SAR · oriented boxes</span>
          </article>
          <article>
            <div class="detector-top"><span class="detector-status is-live">Available</span><span class="num">D-02</span></div>
            <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M32 4l8 14v34l-8 8-8-8V18z"/><path d="M28 24h8M28 32h8M28 40h8"/></svg>
            <h3>Ships</h3>
            <p>Naval and commercial vessels in port and at sea, by class and length, including berthing changes over time.</p>
            <span class="detector-meta">EO · SAR · oriented boxes</span>
          </article>
          <article class="is-soon">
            <div class="detector-top"><span class="detector-status">Coming soon</span><span class="num">D-03</span></div>
            <svg viewBox="0 0 64 64" aria-hidden="true"><rect x="12" y="22" width="40" height="22" rx="3"/><rect x="24" y="14" width="16" height="10"/><path d="M40 18h18"/><circle cx="20" cy="48" r="4"/><circle cx="32" cy="48" r="4"/><circle cx="44" cy="48" r="4"/></svg>
            <h3>Armed forces vehicles</h3>
            <p>Armour, artillery, logistics and air-defence vehicles at garrisons, depots and staging areas.</p>
            <span class="detector-meta">In development</span>
          </article>
        </div>
        <TaxonomyDrill />
      </div>
    </section>

    <section class="section">
      <div class="wrap matrix-layout">
        <div class="matrix-intro">
          <span class="label"><span class="label-index">06</span> Every sensor, one record</span>
          <h2>Works when the weather doesn't.</h2>
          <p>
            No single sensor sees everything. EO gives morphology, SAR sees through cloud and at
            night, hyperspectral separates materials. MIAR keeps them in one site record, so a
            cloudy week or a decoy doesn't leave a gap in the picture.
          </p>
        </div>
        <div>
          <SensorMatrix />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap record-layout">
        <EvidenceRecord />
        <div class="section-head-body">
          <span class="label"><span class="label-index">07</span> Evidence</span>
          <h2>Every finding keeps its evidence.</h2>
          <p class="lead">When a finding reaches a commander, a partner or an auditor, its provenance travels with it.</p>
          <ol class="record-notes">
            <li><span class="pin" aria-hidden="true">1</span><div><strong>The source scenes</strong><p>The current scene and the baseline it was compared against, exactly as the analyst saw them.</p></div></li>
            <li><span class="pin" aria-hidden="true">2</span><div><strong>The detection confidence</strong><p>What was detected, at which level of the class, family and type hierarchy, and how confident the detector was.</p></div></li>
            <li><span class="pin" aria-hidden="true">3</span><div><strong>The analyst's decision</strong><p>Who qualified or rejected the finding, and why. Nothing is published without it.</p></div></li>
            <li><span class="pin" aria-hidden="true">4</span><div><strong>The full history</strong><p>Every step from scene receipt to dissemination, so anyone relying on the finding can check it.</p></div></li>
          </ol>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">08</span> The output</span>
          <div class="section-head-body">
            <h2>Not a bounding box. A governed change to the operational picture.</h2>
            <p class="lead">
              Each qualified finding is published as an intelligence contract that downstream
              systems can trust: detections, counts, deltas, confidence and provenance, with the
              analyst's state attached.
            </p>
          </div>
        </div>
        <IntelligenceContract />
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">09</span> Who it's for</span>
          <div class="section-head-body">
            <h2>Built for the people who turn imagery into decisions.</h2>
          </div>
        </div>
        <div class="users">
          {users.map((user) => (
            <article>
              <span class="label">{user.unit}</span>
              <h3>{user.role}</h3>
              <p>{user.need}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">10</span> Use cases</span>
          <div class="section-head-body">
            <h2>Built around the questions analysts are actually asked.</h2>
          </div>
        </div>
        <div class="cases">
          {solutions.map((solution) => (
            <a class="case-row" href={`/solutions/${solution.slug}/`}>
              <span class="num">{solution.number}</span>
              <h3>{solution.name}</h3>
              <p class="case-q">{solution.question}</p>
              <span class="case-arrow" aria-hidden="true">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section on-night">
      <div class="wrap">
        <div class="section-head">
          <span class="label"><span class="label-index">11</span> Sovereign operation</span>
          <div class="section-head-body">
            <h2>The strongest trust signal is architectural.</h2>
            <p class="lead">
              Process the scene. Qualify the finding. Export the assessment. Then disconnect the
              external network. MIAR runs entirely inside a customer-controlled environment.
            </p>
          </div>
        </div>
        <div class="sovereign">
          <div><strong>Imagery</strong>remains local</div>
          <div><strong>Detectors</strong>run locally</div>
          <div><strong>Judgement</strong>stays human</div>
          <div><strong>Evidence</strong>remains traceable</div>
        </div>
        <div class="pillars">
          <article>
            <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="8" cy="9" r="3"/><circle cx="8" cy="18" r="3"/><circle cx="8" cy="27" r="3"/><path d="M11 9c7 0 7 9 14 9M11 27c7 0 7-9 14-9M11 18h14"/><rect x="25" y="14" width="8" height="8"/></svg>
            <h3>Provider-agnostic</h3>
            <p>Commercial constellations, national collection and public missions such as Sentinel and Landsat, in one exploitation workflow.</p>
          </article>
          <article>
            <svg viewBox="0 0 36 36" aria-hidden="true"><path d="M18 3l12 5v9c0 8-5 13-12 16C11 30 6 25 6 17V8z"/><rect x="13" y="15" width="10" height="8"/><path d="M15 15v-3a3 3 0 016 0v3"/></svg>
            <h3>Connect, don't duplicate</h3>
            <p>Integrates with your basemaps, ORBAT, GIS and command interfaces through open standards, rather than replacing them.</p>
          </article>
          <article>
            <svg viewBox="0 0 36 36" aria-hidden="true"><circle cx="18" cy="11" r="6"/><path d="M6 33c0-7 5-11 12-11s12 4 12 11"/><path d="M13 27l3.5 3.5L24 24"/></svg>
            <h3>Analyst authority</h3>
            <p>Detector output stays a candidate until an analyst qualifies it. Only qualified findings reach the operational picture.</p>
          </article>
        </div>
      </div>
    </section>

    {latest && (
      <section class="section section-tight">
        <div class="wrap">
          <div class="section-head" style="margin-bottom: 40px">
            <span class="label"><span class="label-index">12</span> Insights</span>
            <div class="section-head-body" style="grid-template-columns: 1fr auto; align-items: end; max-width: none">
              <h2>From the ReachDefence team.</h2>
              <a class="text-link" href="/blogs/">All articles <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <a class="insight-feature" href={`/blogs/posts/${latest.id}/`}>
            <div class="insight-feature-image">
              <img src={latest.data.gallery.at(-1)?.src ?? latest.data.heroImage} alt={latest.data.gallery.at(-1)?.alt ?? latest.data.heroImageAlt} width={latest.data.gallery.at(-1)?.width ?? latest.data.heroImageWidth} height={latest.data.gallery.at(-1)?.height ?? latest.data.heroImageHeight} loading="lazy" decoding="async" />
            </div>
            <div class="insight-feature-copy">
              <div class="meta-row">
                <span>{latest.data.category}</span>
                <time datetime={latest.data.publishedAt.toISOString()}>{formatDate(latest.data.publishedAt)}</time>
                <span>{latest.data.readingMinutes} min read</span>
              </div>
              <h3>{latest.data.title}</h3>
              <p>{latest.data.summary}</p>
              <span class="text-link">Read the article <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </div>
      </section>
    )}

    <section class="section" id="waitlist">
      <div class="wrap request">
        <div class="request-copy">
          <span class="label"><span class="label-index">13</span> Request access</span>
          <h2>Begin with one operational question.</h2>
          <p>
            MIAR is available to defence and government imagery teams, GEOINT cells, research
            groups and programme offices. Tell us about the sites you watch and the imagery you
            receive. We'll come back to you directly.
          </p>
          <ol class="next-steps">
            <li><span class="num">01</span><div><strong>We review your request</strong><p>Every request is checked for fit, eligibility and jurisdiction.</p></div></li>
            <li><span class="num">02</span><div><strong>A focused validation discussion</strong><p>One representative mission thread, with your analyst and integration leads.</p></div></li>
            <li><span class="num">03</span><div><strong>A scoped evaluation</strong><p>A sanitised scene pair or public-data equivalent, inside an agreed deployment boundary.</p></div></li>
          </ol>
          <p class="request-note">
            <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8"/><path d="M10 6v5M10 13.5v.5"/></svg>
            Please don't include classified, export-controlled or operationally sensitive information in this form.
          </p>
        </div>
        <RequestForm />
      </div>
    </section>
  </main>
</BaseLayout>
