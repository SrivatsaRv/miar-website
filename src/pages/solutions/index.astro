---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { solutions } from "../../data/solutions";
---

<BaseLayout
  title="MIAR Solutions | Operational Imagery Intelligence"
  description="Explore MIAR solutions for tactical ISR, military asset monitoring, change and posture analysis, archive trends, and sovereign delivery."
  current="solutions"
>
  <main class="subpage-shell solutions-index-shell">
    <section class="solutions-index-hero">
      <div>
        <p class="eyebrow">Solutions</p>
        <h1>Imagery intelligence for recurring military sites.</h1>
      </div>
      <div class="solutions-index-intro">
        <p class="lead">
          MIAR gives analysts one place to work across current imagery, archive scenes,
          detections, comparisons, and review. The collection source can change. The
          intelligence record stays consistent.
        </p>
        <a class="text-link" href="/capabilities/">View the complete capability spine <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="solutions-index-list" aria-label="MIAR solutions">
      {
        solutions.map((solution) => (
          <a class="solution-index-row" href={`/solutions/${solution.slug}/`}>
            <span class="solution-index-number">{solution.number}</span>
            <div>
              <p class="eyebrow eyebrow-compact">{solution.eyebrow}</p>
              <h2>{solution.title}</h2>
              <p>{solution.summary}</p>
            </div>
            <span class="solution-index-arrow" aria-hidden="true">↗</span>
          </a>
        ))
      }
    </section>

    <section class="solution-index-close">
      <p class="eyebrow">MIAR</p>
      <h2>Use the imagery available. Keep one intelligence record.</h2>
      <a class="button button-primary" href="/#waitlist">Discuss your operating requirement</a>
    </section>
  </main>
</BaseLayout>
