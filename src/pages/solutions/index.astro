---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { solutions } from "../../data/solutions";
---

<BaseLayout
  socialImage="/social/v2/solutions.jpg"
  title="Solutions | MIAR"
  description="How MIAR helps defence analysts answer the questions they are asked about monitored sites: what is there, how many, what changed, what is trending, and where the work can run."
  current="solutions"
>
  <main class="subpage-shell">
    <div class="wrap">
      <section class="page-hero">
        <span class="label"><span class="label-index">—</span> Solutions</span>
        <div class="page-hero-body">
          <h1>One review process for every question about a site.</h1>
          <p class="lead">
            Current imagery, archive scenes, detections, comparisons and analyst decisions in one place.
            Imagery providers can change. The site record stays consistent.
          </p>
          <div class="page-hero-actions">
            <a class="button button-primary" href="/#waitlist">Request access <span class="arrow" aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="/capabilities/">How it works</a>
          </div>
        </div>
      </section>

      <section class="solutions-grid" aria-label="MIAR solutions">
        {solutions.map((solution) => (
          <a class="solution-card" href={`/solutions/${solution.slug}/`}>
            <div class="solution-card-top">
              <span class="num">{solution.number}</span>
              <span class="case-arrow" aria-hidden="true">→</span>
            </div>
            <h2>{solution.name}</h2>
            <p class="case-q">{solution.question}</p>
            <p>{solution.summary}</p>
          </a>
        ))}
      </section>
    </div>
  </main>
</BaseLayout>
