---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { solutions } from "../../data/solutions";
---

<BaseLayout
  socialImage="/social/v2/solutions.jpg"
  title="Solutions | MIAR"
  description="Five questions asked of a monitored site: what is there now, how many of each type and where, whether a change is routine, how activity trends, and whether exploitation can run inside your own boundary."
  current="solutions"
>
  <main class="subpage-shell">
    <div class="wrap">
      <section class="page-hero">
        <span class="label">Solutions</span>
        <div class="page-hero-body">
          <h1>Five questions asked of a monitored site, answered on one exploitation thread.</h1>
          <p class="lead">
            Each solution uses the same thread: scenes co-registered to the site, detection by type,
            comparison with the last usable scene, analyst qualification and a published finding.
            They differ in the question asked of the site and in what gets published.
          </p>
          <div class="page-hero-actions">
            <a class="button button-primary" href="/#waitlist">Request access <span class="arrow" aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="/capabilities/">How it works</a>
          </div>
        </div>
      </section>

      <section class="solutions-grid" aria-label="MIAR solutions">
        {solutions.map((solution) => (
          <a class="solution-card" href={`/solutions/${solution.slug}/`}>
            <div class="solution-card-top">
              <span class="num">{solution.number}</span>
              <span class="case-arrow" aria-hidden="true">→</span>
            </div>
            <h2>{solution.name}</h2>
            <p class="case-q">{solution.question}</p>
            <p>{solution.summary}</p>
          </a>
        ))}
      </section>
    </div>
  </main>
</BaseLayout>
