---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChangeCompare from "../../components/ChangeCompare.astro";
import TacticalScene from "../../components/TacticalScene.astro";
import AssetRegister from "../../components/AssetRegister.astro";
import TrendChart from "../../components/TrendChart.astro";
import DeliveryFlow from "../../components/DeliveryFlow.astro";
import { solutions, type Solution } from "../../data/solutions";

export function getStaticPaths() {
  return solutions.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
const index = solutions.findIndex((item) => item.slug === solution.slug);
const previous = solutions[(index - 1 + solutions.length) % solutions.length];
const next = solutions[(index + 1) % solutions.length];
---

<BaseLayout socialImage={`/social/v2/solution-${solution.slug}.jpg`} socialImageAlt={`MIAR solutions: ${solution.title}`} title={`${solution.name} | MIAR Solutions`} description={solution.summary} current="solutions">
  <main class="subpage-shell">
    <div class="wrap">
      <section class="solution-hero">
        <div class="solution-hero-top">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="/solutions/">Solutions</a><span>/</span><span>{solution.number} of 0{solutions.length}</span>
          </nav>
          <span class="solution-question">{solution.question}</span>
        </div>
        <div class="solution-hero-grid">
          <div style="display: grid; gap: 20px">
            <span class="label"><span class="label-index">{solution.number}</span> {solution.name}</span>
            <h1>{solution.title}</h1>
          </div>
          <div style="display: grid; gap: 24px">
            <p class="lead">{solution.summary}</p>
            <div class="page-hero-actions">
              <a class="button button-primary" href="/#waitlist">Request access <span class="arrow" aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </section>

      <section aria-label={`${solution.name} example`}>
        {solution.visual === "scene" && <TacticalScene />}
        {solution.visual === "monitor" && <AssetRegister />}
        {solution.visual === "compare" && <ChangeCompare id="solution-compare" />}
        {solution.visual === "trend" && <TrendChart />}
        {solution.visual === "delivery" && <DeliveryFlow />}
      </section>

      <section class="solution-thesis">
        <span class="label">Why it matters</span>
        <blockquote>{solution.thesis}</blockquote>
      </section>

      <div class="solution-body">
        <section>
          <span class="label">The problem</span>
          <h2>{solution.problemTitle}</h2>
          <p>{solution.problem}</p>
        </section>
        <section>
          <span class="label">How MIAR handles it</span>
          <h2>{solution.approachTitle}</h2>
          <ol class="step-list">
            {solution.approach.map((step) => <li>{step}</li>)}
          </ol>
        </section>
        <section>
          <span class="label">What the analyst gets</span>
          <h2>{solution.outputTitle}</h2>
          <ul class="check-list">
            {solution.outputs.map((output) => <li>{output}</li>)}
          </ul>
          <p>{solution.outcome}</p>
        </section>
      </div>

      <nav class="solution-next" aria-label="More solutions">
        <a href={`/solutions/${previous.slug}/`}>
          <span class="label">← Previous · {previous.number}</span>
          <strong>{previous.name}</strong>
        </a>
        <a href={`/solutions/${next.slug}/`}>
          <span class="label">Next · {next.number} →</span>
          <strong>{next.name}</strong>
        </a>
      </nav>
    </div>
  </main>
</BaseLayout>
