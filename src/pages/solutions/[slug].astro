---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { solutions, type Solution } from "../../data/solutions";

export function getStaticPaths() {
  return solutions.map((solution) => ({
    params: { slug: solution.slug },
    props: { solution },
  }));
}

interface Props {
  solution: Solution;
}

const { solution } = Astro.props;
const currentIndex = solutions.findIndex((item) => item.slug === solution.slug);
const nextSolution = solutions[(currentIndex + 1) % solutions.length];
---

<BaseLayout
  title={`${solution.eyebrow} | MIAR Solutions`}
  description={solution.summary}
  current="solutions"
>
  <main class="subpage-shell solution-detail-shell">
    <section class="solution-detail-hero">
      <div class="solution-detail-kicker">
        <span>{solution.number} / 05</span>
      </div>
      <p class="eyebrow">{solution.eyebrow}</p>
      <h1>{solution.title}</h1>
      <p class="lead">{solution.summary}</p>
    </section>

    <section class:list={["solution-evidence", `solution-evidence-${solution.visual}`]} aria-label={`${solution.eyebrow} representative workflow`}>
      {
        solution.visual === "scene" && (
          <>
            <img src="/imagery/bholari-2026.png" alt="Bholari airbase current imagery used as a representative recurring AOI review" width="1546" height="1090" />
            <div class="solution-evidence-shade"></div>
            <div class="solution-evidence-tag tag-a"><span>Current scene</span><strong>Latest pass aligned</strong></div>
            <div class="solution-evidence-tag tag-b"><span>Analyst cue</span><strong>Apron activity ready for review</strong></div>
          </>
        )
      }
      {
        solution.visual === "monitor" && (
          <div class="solution-monitor">
            <div><span>Aircraft</span><strong>06</strong><p>Visible in current review</p></div>
            <div><span>C-130</span><strong>05</strong><p>Transport aircraft</p></div>
            <div><span>P-3C</span><strong>01</strong><p>Maritime patrol aircraft</p></div>
            <div><span>Review</span><strong>Analyst</strong><p>Confirmation remains explicit</p></div>
          </div>
        )
      }
      {
        solution.visual === "compare" && (
          <div class="solution-compare">
            <figure><img src="/imagery/bholari-2025.png" alt="Bholari archive imagery from 2025" width="1564" height="1136" /><figcaption>Baseline / 2025</figcaption></figure>
            <div class="solution-compare-marker"><span>Compare</span><strong>Layout shift</strong><p>Same asset count. Changed apron arrangement.</p></div>
            <figure><img src="/imagery/bholari-2026.png" alt="Bholari current imagery from 2026" width="1546" height="1090" /><figcaption>Current / 2026</figcaption></figure>
          </div>
        )
      }
      {
        solution.visual === "trend" && (
          <div class="solution-trend">
            <div class="solution-trend-axis"><span>Presence by type</span><strong>AOI activity record</strong></div>
            <div class="solution-trend-chart" aria-hidden="true">
              <i></i><i></i><i></i><i></i><i></i><i></i>
            </div>
            <div class="solution-trend-labels"><span>Archive</span><span>Current</span></div>
          </div>
        )
      }
      {
        solution.visual === "delivery" && (
          <div class="solution-delivery">
            <article><span>01 / Intake</span><strong>Multi-provider imagery</strong></article>
            <div class="delivery-arrow"></div>
            <article><span>02 / MIAR</span><strong>Interpretation + review</strong></article>
            <div class="delivery-arrow"></div>
            <article><span>03 / Delivery</span><strong>Approved operational output</strong></article>
          </div>
        )
      }
    </section>

    <blockquote class="solution-thesis">{solution.thesis}</blockquote>

    <section class="solution-narrative">
      <div>
        <p class="eyebrow">Why it matters</p>
        <h2>{solution.problemTitle}</h2>
      </div>
      <p>{solution.problem}</p>
    </section>

    <section class="solution-method">
      <div class="solution-method-heading">
        <p class="eyebrow">Workflow</p>
        <h2>{solution.approachTitle}</h2>
      </div>
      <ol>
        {solution.approach.map((step, index) => (
          <li><span>0{index + 1}</span><p>{step}</p></li>
        ))}
      </ol>
    </section>

    <section class="solution-outputs">
      <div>
        <p class="eyebrow">What the analyst gets</p>
        <h2>{solution.outputTitle}</h2>
        <p>{solution.outcome}</p>
      </div>
      <ul>
        {solution.outputs.map((output) => <li>{output}</li>)}
      </ul>
    </section>

    <section class="solution-next">
      <span>Next solution / {nextSolution.number}</span>
      <a href={`/solutions/${nextSolution.slug}/`}>
        <strong>{nextSolution.eyebrow}</strong>
        <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>
</BaseLayout>
