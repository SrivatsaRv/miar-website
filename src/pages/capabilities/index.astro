---
import BaseLayout from "../../layouts/BaseLayout.astro";
import OptimizedPicture from "../../components/OptimizedPicture.astro";

const valueChain = [
  {
    step: "01",
    title: "Collect",
    body: "Load current and archive scenes from the available providers.",
  },
  {
    step: "02",
    title: "Interpret",
    body: "Run detection and comparison, then record the analyst decision.",
  },
  {
    step: "03",
    title: "Deliver",
    body: "Send reviewed findings to the systems and teams that use them.",
  },
];

const capabilities = [
  {
    key: "tactical",
    eyebrow: "Tactical ISR",
    title: "Review the latest pass against the site history.",
    body:
      "Open the current scene beside earlier coverage and check aircraft, vehicles, equipment, construction, and site activity.",
    points: [
      "Recurring AOI monitoring for current operational questions",
      "Current-scene review with classed detections and analyst confirmation",
      "Evidence-backed outputs that help teams move from scene receipt to decision support",
    ],
  },
  {
    key: "assets",
    eyebrow: "Military Asset Monitoring",
    title: "Count assets and preserve where they were found.",
    body:
      "Record visible assets by class while retaining their position, spacing, and distribution across the site.",
    points: [
      "Detection and tabulation of aircraft, vessels, vehicles, equipment, and other visible assets",
      "Structured summaries that surface changes in deployment, density, and configuration",
      "Analyst review loop for separating machine suggestion from approved output",
    ],
  },
  {
    key: "posture",
    eyebrow: "Change + Posture",
    title: "Show the difference, then record the analyst's judgement.",
    body:
      "Align two scenes, identify the objects involved, and separate routine movement from a difference that needs review.",
    points: [
      "Scene-to-scene compare for visible asset movement and structural change",
      "Support for posture interpretation rather than simple binary change flags",
      "Evidence trail that preserves source scene, model output, confidence, and analyst decision",
    ],
  },
  {
    key: "trend",
    eyebrow: "Archive + Trend",
    title: "Build a site history from repeated observations.",
    body:
      "Use consistent classes and review questions across each pass so counts and layout changes can be compared over time.",
    points: [
      "Historical scene access for longer-run comparison and pattern development",
      "Trend views such as aircraft presence by type across the same AOI",
      "Before-and-after analysis for activity surges, buildup, dispersal, and recovery",
    ],
  },
  {
    key: "delivery",
    eyebrow: "Sovereign Delivery",
    title: "Keep data, review, and delivery under customer control.",
    body:
      "Keep source imagery, analyst actions, model output, and approved findings inside the required deployment boundary.",
    points: [
      "Vendor-agnostic collection intake with MIAR-native intelligence extraction downstream",
      "Secure delivery and integration posture for operational consumers",
      "Deployment patterns aligned with sovereign, on-premise, or controlled environments where required",
    ],
  },
];
---

<BaseLayout
  title="MIAR Capabilities | Decision-Ready ISR"
  description="Tactical ISR, military asset monitoring, change and posture detection, archive trend intelligence, and sovereign delivery through MIAR."
  current="capabilities"
>
  <main class="subpage-shell capabilities-shell">
    <section class="capabilities-hero-stage">
      <div class="capabilities-hero-copy">
        <p class="eyebrow">Capabilities</p>
        <h1>One review process across every collection source.</h1>
        <p class="lead">
          Bring current and archive imagery into a common record. Run detections and comparisons,
          record analyst decisions, and deliver approved findings without tying the workflow to
          one provider.
        </p>
        <p class="capability-thesis-line">
          Collection changes. Review standards do not.
        </p>
        <div class="mini-links">
          <a href="/#waitlist">Request access</a>
          <a href="/legal/">Legal notice</a>
        </div>
      </div>

      <aside class="capabilities-hero-visual" aria-label="Representative MIAR intelligence view">
        <div class="capability-register">
          <div class="capability-register-head">
            <span>Review register</span>
            <strong>Monitored site / current assessment</strong>
          </div>
          <dl>
            <div><dt>Current scene</dt><dd>03 Jul 2026</dd><span>Aligned</span></div>
            <div><dt>Selected baseline</dt><dd>26 Jun 2026</dd><span>Loaded</span></div>
            <div><dt>Visible aircraft</dt><dd>06 candidates</dd><span>Reviewed</span></div>
            <div><dt>Layout difference</dt><dd>01 observation</dd><span>Open</span></div>
          </dl>
          <p>Source, model output, comparison, and analyst state remain attached to the same review.</p>
        </div>
      </aside>
    </section>

    <section class="capability-spine">
      <div class="capability-spine-head">
        <p class="eyebrow eyebrow-compact">Capability Spine</p>
        <h2>Collection in. Reviewed finding out.</h2>
      </div>

      <div class="capability-spine-track">
        {
          valueChain.map((item) => (
            <article class="capability-spine-step">
              <span>{item.step}</span>
              <strong>{item.title}</strong>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    {
      capabilities.map((capability, index) => (
        <section class:list={["capability-band", index % 2 === 1 && "is-reversed"]}>
          <div class="capability-copy">
            <p class="eyebrow">{capability.eyebrow}</p>
            <h2>{capability.title}</h2>
            <p>{capability.body}</p>
            <ul class="capability-points-list">
              {capability.points.map((point) => <li>{point}</li>)}
            </ul>
          </div>

          <div class={`capability-visual capability-visual-${capability.key}`}>
            {capability.key === "tactical" && (
              <div class="tactical-review-board">
                <div>
                  <span>Current pass</span>
                  <strong>03 Jul / 07:42</strong>
                </div>
                <ol>
                  <li><span>Aircraft</span><strong>6 visible</strong></li>
                  <li><span>Baseline</span><strong>26 Jun selected</strong></li>
                  <li><span>Review</span><strong>1 layout change open</strong></li>
                </ol>
                <p>Every observation remains linked to its scene and review state.</p>
              </div>
            )}

            {capability.key === "assets" && (
              <div class="monitor-board">
                <div class="monitor-board-head">
                  <span>Asset watch</span>
                  <strong>Monitored airbase summary</strong>
                </div>
                <div class="monitor-board-grid">
                  <article>
                    <span>Aircraft</span>
                    <strong>06</strong>
                    <p>Visible aircraft in current review</p>
                  </article>
                  <article>
                    <span>C-130</span>
                    <strong>05</strong>
                    <p>Transport aircraft detected</p>
                  </article>
                  <article>
                    <span>P-3C</span>
                    <strong>01</strong>
                    <p>Maritime patrol aircraft detected</p>
                  </article>
                  <article>
                    <span>Confidence</span>
                    <strong>0.9137</strong>
                    <p>Aggregate scene confidence</p>
                  </article>
                </div>
                <div class="monitor-board-callout">
                  <span>Review note</span>
                  <strong>Counts alone are not the story. Placement and spacing matter too.</strong>
                  <p>Analyst review separates machine suggestion from approved output.</p>
                </div>
              </div>
            )}

            {capability.key === "posture" && (
              <div class="compare-board">
                <div class="compare-board-head">
                  <span>Compare</span>
                  <strong>Reference 2025 vs follow-on 2026</strong>
                </div>
                <div class="compare-images">
                  <figure>
                    <OptimizedPicture name="monitored-site-reference-2025" alt="Monitored airbase archive view from 2025" width={1564} height={1136} />
                    <figcaption>Prior scene</figcaption>
                  </figure>
                  <figure>
                    <OptimizedPicture name="monitored-site-follow-on-2026" alt="Monitored airbase follow-on view from 2026" width={1546} height={1090} />
                    <figcaption>Current scene</figcaption>
                  </figure>
                </div>
                <div class="compare-panels">
                  <article>
                    <span>Prior</span>
                    <strong>Five C-130s + one P-3C</strong>
                    <p>Aircraft presence is steady, but the apron arrangement is different.</p>
                  </article>
                  <article>
                    <span>Latest</span>
                    <strong>Apron shift</strong>
                    <p>MIAR preserves the same count while surfacing a changed spatial layout.</p>
                  </article>
                </div>
                <div class="compare-deltas">
                  <div>
                    <span>Shift</span>
                    <strong>Apron layout changed</strong>
                  </div>
                  <div>
                    <span>Counts</span>
                    <strong>No aircraft count delta</strong>
                  </div>
                  <div>
                    <span>Compare confidence</span>
                    <strong>0.9067 with provenance attached</strong>
                  </div>
                </div>
              </div>
            )}

            {capability.key === "trend" && (
              <div class="trend-board">
                <div class="trend-board-head">
                  <span>Trend intelligence</span>
                  <strong>Repeat observations become an activity record</strong>
                </div>
                <div class="trend-bars" aria-hidden="true">
                  <article>
                    <span>2025</span>
                    <div><i class="is-primary" style="height: 68%"></i><i style="height: 18%"></i><i class="is-accent" style="height: 14%"></i></div>
                  </article>
                  <article>
                    <span>2026</span>
                    <div><i class="is-primary" style="height: 68%"></i><i style="height: 18%"></i><i class="is-accent" style="height: 14%"></i></div>
                  </article>
                </div>
                <div class="trend-legend">
                  <span><i></i> C-130 presence</span>
                  <span><i class="is-secondary"></i> P-3C presence</span>
                  <span><i class="is-accent"></i> Layout-change marker</span>
                </div>
                <p class="trend-caption">
                  Plot presence by type and preserve scene-to-scene change context instead of
                  treating every image as an isolated event.
                </p>
              </div>
            )}

            {capability.key === "delivery" && (
              <div class="delivery-board">
                <div class="delivery-board-head">
                  <span>Delivery posture</span>
                  <strong>Secure downstream handoff with MIAR as the interpretation layer</strong>
                </div>
                <div class="delivery-lane" aria-hidden="true">
                  <article>
                    <span>Collection intake</span>
                    <strong>Multi-provider scenes</strong>
                  </article>
                  <div class="delivery-arrow"></div>
                  <article>
                    <span>MIAR layer</span>
                    <strong>Detection, compare, review</strong>
                  </article>
                  <div class="delivery-arrow"></div>
                  <article>
                    <span>Operational consumer</span>
                    <strong>Secure brief, API, and controlled delivery</strong>
                  </article>
                </div>
                <div class="delivery-flags">
                  <span>On-premise options</span>
                  <span>Controlled review</span>
                  <span>Provenance attached</span>
                  <span>National authority retained</span>
                </div>
              </div>
            )}
          </div>
        </section>
      ))
    }

    <section class="capability-close">
      <p class="eyebrow eyebrow-compact">Request Access</p>
      <h2>Review recurring military sites with the source evidence attached.</h2>
      <p>
        Talk to us if your team reviews repeat imagery of airfields, bases, ports, launch
        areas, or operating zones and needs detections, comparisons, and analyst decisions
        kept in one record.
      </p>
      <p>
        <a class="button button-primary" href="/#waitlist">Request access</a>
      </p>
    </section>
  </main>
</BaseLayout>
