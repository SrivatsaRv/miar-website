---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChangeCompare from "../../components/ChangeCompare.astro";
import TacticalScene from "../../components/TacticalScene.astro";

const passes = [
  { time: "06:42Z", provider: "Provider A", sensor: "EO", note: "Clear, 0.5 m", state: "Ready" },
  { time: "02:10Z", provider: "Provider B", sensor: "SAR", note: "Night pass", state: "Ready" },
  { time: "Yesterday", provider: "Provider C", sensor: "HSI", note: "Material map", state: "Ready" },
  { time: "Yesterday", provider: "Provider A", sensor: "EO", note: "80% cloud", state: "Low value" },
  { time: "2025", provider: "Archive", sensor: "EO", note: "Baseline", state: "Baseline" },
];
---

<BaseLayout
  socialImage="/social/v2/how-it-works.jpg"
  title="How it works | MIAR"
  description="How MIAR takes imagery from any provider through detection, comparison and analyst review to an approved finding with its evidence attached."
  current="capabilities"
>
  <main class="subpage-shell">
    <div class="wrap">
      <section class="page-hero">
        <span class="label"><span class="label-index">—</span> How it works</span>
        <div class="page-hero-body">
          <h1>From received scene to qualified finding, with nothing lost on the way.</h1>
          <p class="lead">
            You focus on obtaining imagery. MIAR brings every scene of a site into one record, exploits
            it with purpose-trained detection models, and puts each finding in front of an analyst
            with its evidence. Only qualified findings leave.
          </p>
          <div class="page-hero-actions">
            <a class="button button-primary" href="/#waitlist">Request access <span class="arrow" aria-hidden="true">→</span></a>
            <a class="button button-secondary" href="/solutions/">See use cases</a>
          </div>
        </div>
      </section>

      <div class="stages">
        <section class="stage">
          <div class="stage-copy">
            <span class="num">01 · Register</span>
            <h2>Every scene of the site, in one queue.</h2>
            <p>Your focus stays on obtaining imagery. Tasked and archive scenes arrive from whichever providers you use, in native formats. MIAR orthorectifies and co-registers each pass against the right site, so analysts start from a queue, not a download folder.</p>
            <ul class="check-list">
              <li>Commercial and national sources side by side</li>
              <li>Optical, radar, hyperspectral and thermal</li>
              <li>Unusable passes, such as heavy cloud or extreme look angle, flagged before anyone opens them</li>
            </ul>
          </div>
          <div class="stage-visual plate plate-light">
            <div class="plate-head"><span>Incoming passes · <strong>Site 014</strong></span><span>Illustrative</span></div>
            <table class="register-table pass-table">
              <thead><tr><th>Received</th><th>Source</th><th>Sensor</th><th>Note</th><th>Status</th></tr></thead>
              <tbody>
                {passes.map((pass) => (
                  <tr>
                    <td class="num">{pass.time}</td>
                    <td>{pass.provider}</td>
                    <td><span class="sensor-chip">{pass.sensor}</span></td>
                    <td>{pass.note}</td>
                    <td class:list={[pass.state === "Low value" && "is-change"]}>{pass.state}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="stage">
          <div class="stage-copy">
            <span class="num">02 · Detect</span>
            <h2>Purpose-trained detection, with a confidence you can see.</h2>
            <p>Specialised ML models, trained on overhead imagery of military targets, detect aircraft and ships as oriented boxes and classify them by family and type. Armed forces vehicles are next. Every detection carries its confidence, none is hidden, and none is rounded up.</p>
          </div>
          <div class="stage-visual"><TacticalScene /></div>
        </section>

        <section class="stage">
          <div class="stage-copy">
            <span class="num">03 · Compare</span>
            <h2>Separate real change from geometry, atmosphere and sensor mismatch.</h2>
            <p>The new pass is compared against the last usable scene and the site's history, then correlated with installation layout, ORBAT and activity. MIAR compares objects and their positions, not just pixels, so a reorganised apron is caught even when the count is the same.</p>
          </div>
          <div class="stage-visual"><ChangeCompare id="caps-compare" summary={false} /></div>
        </section>

        <section class="stage">
          <div class="stage-copy">
            <span class="num">04 · Qualify</span>
            <h2>An analyst makes every call.</h2>
            <p>Each finding arrives with its scenes, the detector's reading and what the other sensors show. The analyst accepts, rejects or annotates it. That decision is recorded against their name.</p>
            <ul class="check-list">
              <li>Readings from every sensor shown side by side</li>
              <li>Disagreements between sensors are highlighted, not averaged away</li>
              <li>Notes and decisions are kept with the finding</li>
            </ul>
          </div>
          <div class="stage-visual plate">
            <div class="plate-head"><span>Review · <strong>Candidate C-3</strong></span><span>Illustrative</span></div>
            <div class="review-ui">
              <div class="review-ui-finding">
                <svg viewBox="420 545 150 94" aria-hidden="true">
                  <image href="/imagery/monitored-site-follow-on-2026.webp" x="2" y="78" width="1546" height="1090" />
                </svg>
                <div>
                  <strong>Aircraft-shaped object, south apron</strong>
                  <p>Optical sees an aircraft. Radar shows no metal return. Hyperspectral reads polymer fabric.</p>
                </div>
              </div>
              <div class="review-ui-actions">
                <span class="is-chosen">Accept as decoy</span>
                <span>Reject</span>
                <span>Escalate</span>
              </div>
              <p class="review-ui-note"><span>Analyst note · 09:18Z</span>Consistent with an inflatable decoy. Recheck with the next SAR pass.</p>
            </div>
          </div>
        </section>

        <section class="stage">
          <div class="stage-copy">
            <span class="num">05 · Publish</span>
            <h2>Qualified findings go where they are needed, with their provenance.</h2>
            <p>Findings are published as an intelligence contract to the operational picture, as briefs, or as the next collection cue. Every output links back to the imagery and the decision behind it.</p>
          </div>
          <div class="stage-visual plate">
            <div class="plate-head"><span>Outputs · <strong>Finding F-0147</strong></span><span>Illustrative</span></div>
            <div class="output-cards">
              <article>
                <span>Brief</span>
                <strong>Weekly site summary</strong>
                <p>Images, change notes and analyst sign-off, ready to present.</p>
              </article>
              <article>
                <span>API</span>
                <pre>{`{
  "finding": "F-0147",
  "class": "aircraft",
  "change": `}<b>"new_position"</b>{`,
  "confidence": 0.91,
  "approved_by": "analyst-07"
}`}</pre>
              </article>
              <article>
                <span>Collection</span>
                <strong>Next-look request</strong>
                <p>Revisit Site 014 with SAR within 48 hours to confirm the decoy assessment.</p>
              </article>
            </div>
          </div>
        </section>
      </div>

      <section class="section-tight">
        <div class="section-head" style="margin-bottom: 40px">
          <span class="label">What stays constant</span>
          <div class="section-head-body"><h2>Imagery sources change. Review standards don't.</h2></div>
        </div>
        <div class="principles">
          <article><h3>Provider-neutral</h3><p>Switch or add imagery suppliers without retraining your analysts.</p></article>
          <article><h3>Evidence first</h3><p>No finding exists without the imagery and comparison behind it.</p></article>
          <article><h3>Analyst authority</h3><p>Detector output is a candidate until an analyst qualifies it.</p></article>
          <article><h3>Your boundary</h3><p>Deploy in controlled, on-premise or sovereign environments.</p></article>
        </div>
      </section>

      <section class="cta-band">
        <div>
          <h2>Review recurring military sites with the source evidence attached.</h2>
          <p>Talk to us if your team reviews repeat imagery of airfields, bases, ports or operating areas.</p>
        </div>
        <div class="cta-band-actions">
          <a class="button button-primary" href="/#waitlist">Request access</a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
