---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="MIAR Legal Information"
  description="Legal and policy information for the public MIAR website."
  current="legal"
>
  <main class="subpage-shell legal-shell">
    <section class="subpage-hero legal-hero">
      <p class="eyebrow">Legal</p>
      <h1>Policies for the public MIAR website.</h1>
      <p class="lead">
        These documents cover this website and its request-access form. Pilots, evaluations,
        imagery access, platform use, and customer deployments require separate written terms.
      </p>
    </section>

    <nav class="legal-policy-list" aria-label="MIAR policies">
      <a href="/privacy/">
        <span>01</span>
        <div>
          <h2>Privacy notice</h2>
          <p>What the public site collects, why it is used, and who may access it.</p>
        </div>
        <strong aria-hidden="true">→</strong>
      </a>
      <a href="/terms/">
        <span>02</span>
        <div>
          <h2>Website terms</h2>
          <p>Rules for using the public site and submitting an access request.</p>
        </div>
        <strong aria-hidden="true">→</strong>
      </a>
    </nav>

    <section class="legal-scope-note">
      <p class="eyebrow eyebrow-compact">Scope</p>
      <p>
        The public site does not grant access to MIAR, imagery, models, APIs, or evaluation
        environments. Submission of a request does not create an account, contract, or right
        to access.
      </p>
    </section>
  </main>
</BaseLayout>
