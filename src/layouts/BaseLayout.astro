---
import "../styles/global.css";
import SiteSearch from "../components/SiteSearch.astro";
import Logo from "../components/Logo.astro";
import { requestHref, solutionLinks } from "../data/site";

// Version the shared script by content (hash computed in astro.config.mjs) so each deploy busts caches.
const siteScript = `/site.js?v=${__SITE_JS_VERSION__}`;

interface Props {
  title: string;
  description: string;
  current?: "home" | "solutions" | "capabilities" | "whitepapers" | "blogs" | "legal" | "privacy" | "terms";
  canonicalUrl?: string;
  socialImage?: string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  socialTitle?: string;
  socialDescription?: string;
  noindex?: boolean;
  article?: {
    publishedAt: string;
    updatedAt?: string;
    author: string;
    section: string;
    tags: string[];
  };
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description,
  current = "home",
  canonicalUrl: canonicalOverride,
  socialImage: socialImageOverride,
  socialImageAlt = "MIAR by ReachDefence: know what changed at every site you watch",
  socialImageWidth = 1200,
  socialImageHeight = 630,
  socialTitle,
  socialDescription,
  noindex = false,
  article,
  jsonLd,
} = Astro.props;

const isHome = current === "home";
const siteOrigin = "https://miar.reachdefence.com";
const canonicalUrl = canonicalOverride || new URL(Astro.url.pathname, siteOrigin).toString();
// One card per page (scripts/generate-social-cards.mjs); pages without their own use the home card.
const socialPath = socialImageOverride || "/social/v2/home.jpg";
const socialImage = new URL(socialPath, siteOrigin).toString();
const socialImageType = socialPath.endsWith(".png") ? "image/png" : "image/jpeg";
const safeJsonLd = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : "";
const navItems = [
  { href: "/solutions/", label: "Solutions", active: current === "solutions", children: solutionLinks },
  { href: "/capabilities/", label: "How it works", active: current === "capabilities" },
  { href: "/blogs/", label: "Insights", active: current === "blogs" },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#f4f3ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1214" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      document.documentElement.classList.add("js");
      try {
        const saved = localStorage.getItem("miar-theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <meta property="og:site_name" content="MIAR by ReachDefence" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={socialTitle || title} />
    <meta property="og:description" content={socialDescription || description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={String(socialImageWidth)} />
    <meta property="og:image:height" content={String(socialImageHeight)} />
    <meta property="og:image:alt" content={socialImageAlt} />
    {article && <meta property="article:published_time" content={article.publishedAt} />}
    {article?.updatedAt && <meta property="article:modified_time" content={article.updatedAt} />}
    {article && <meta property="article:author" content={article.author} />}
    {article && <meta property="article:section" content={article.section} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <link rel="canonical" href={canonicalUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle || title} />
    <meta name="twitter:description" content={socialDescription || description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    {safeJsonLd && <script type="application/ld+json" set:html={safeJsonLd} />}
    <link rel="preload" href="/fonts/geist-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
  </head>
  <body data-pagefind-body>
    <header class:list={["site-header", { "site-header-home": isHome }]} data-site-header data-pagefind-ignore>
      <div class="header-shell">
        <a class="brand" href="/" aria-label="MIAR home">
          <Logo />
          <span class="brand-copy">
            <strong>MIAR</strong>
            <span>by ReachDefence</span>
          </span>
        </a>

        <div class="header-controls">
          <nav class="site-nav" id="site-nav" aria-label="Primary navigation">
            {
              navItems.map((item) => item.children ? (
                <div class:list={["nav-group", { "is-active": Boolean(item.active) }]}>
                  <a
                    href={item.href}
                    class:list={{ "is-active": Boolean(item.active) }}
                    aria-current={item.active ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                  <button class="nav-group-toggle" type="button" aria-label="Open Solutions menu" aria-expanded="false" data-nav-group-toggle></button>
                  <div class="nav-submenu">
                    {item.children.map((child) => (
                      <a href={child.href}>{child.label}<span>{child.number}</span></a>
                    ))}
                    <a class="nav-submenu-all" href={item.href}>All solutions <span aria-hidden="true">→</span></a>
                  </div>
                </div>
              ) : (
                <a
                  href={item.href}
                  class:list={{ "is-active": Boolean(item.active) }}
                  aria-current={item.active ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <a class="nav-mobile-cta" href={requestHref}>Request access</a>
          </nav>
          <button class="theme-toggle" type="button" aria-label="Switch colour theme" data-theme-toggle>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></svg>
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 019.5 4a8 8 0 1010.5 10.5z"/></svg>
          </button>
          <SiteSearch />
          <a class="button button-primary header-cta" href={requestHref}>Request access</a>
          <button
            class="nav-toggle"
            type="button"
            aria-expanded="false"
            aria-controls="site-nav"
            aria-label="Toggle navigation"
            data-nav-toggle
          >
            <span></span>
            <span></span>
          </button>
        </div>
      </div>
    </header>

    <slot />

    <footer class="site-footer" data-pagefind-ignore>
      <div class="wrap">
        {!isHome && (
          <div class="footer-cta on-night">
            <h2>See what changed at your sites. <span>Talk to the MIAR team.</span></h2>
            <a class="button button-primary" href={requestHref}>Request access <span class="arrow" aria-hidden="true">→</span></a>
          </div>
        )}

        <div class="footer-grid">
          <div class="footer-brand">
            <a class="brand" href="/" aria-label="MIAR home">
              <Logo />
              <span class="brand-copy">
                <strong>MIAR</strong>
                <span>by ReachDefence</span>
              </span>
            </a>
            <p>The post-reception exploitation layer for defence imagery. Register, exploit, qualify and publish every scene, from any provider.</p>
          </div>

          <div class="footer-col">
            <h3>Product</h3>
            <a href="/capabilities/">How it works</a>
            <a href="/solutions/">Solutions</a>
            <a href="/blogs/">Insights</a>
            <a href={requestHref}>Request access</a>
          </div>

          <div class="footer-col">
            <h3>Solutions</h3>
            {solutionLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          </div>

          <div class="footer-col">
            <h3>Policies</h3>
            <a href="/privacy/">Privacy</a>
            <a href="/terms/">Website terms</a>
            <a href="/legal/">Legal</a>
          </div>
        </div>

        <div class="footer-base">
          <span>© {year} ReachDefence. All rights reserved.</span>
          <span>Access is limited to approved organizations and lawful use.</span>
        </div>
      </div>
    </footer>

    <script src={siteScript} defer></script>
  </body>
</html>
