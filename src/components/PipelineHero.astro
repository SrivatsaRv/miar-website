<script>
  // Pause the motion when off screen, and entirely for reduced motion.
  document.querySelectorAll<HTMLElement>("[data-ph]").forEach((root) => {
    const svgs = [...root.querySelectorAll<SVGSVGElement>("svg")];
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const setRunning = (running: boolean) =>
      svgs.forEach((svg) => (running && !reduced ? svg.unpauseAnimations() : svg.pauseAnimations()));
    if (reduced) {
      setRunning(false);
      return;
    }
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((entries) => setRunning(entries.some((entry) => entry.isIntersecting))).observe(root);
    }
  });
</script>
