<button
  class="site-search-trigger"
  type="button"
  aria-label="Search MIAR"
  aria-haspopup="dialog"
  data-search-open
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="10.8" cy="10.8" r="5.8"></circle>
    <path d="m15.2 15.2 4.1 4.1"></path>
  </svg>
  <span>Search</span>
  <kbd>⌘K</kbd>
</button>

<dialog class="site-search-dialog" aria-labelledby="site-search-title" data-search-dialog>
  <div class="site-search-panel">
    <header class="site-search-head">
      <div>
        <span>Search MIAR</span>
        <h2 id="site-search-title">Find analysis and capabilities</h2>
      </div>
      <button type="button" aria-label="Close search" data-search-close>Close</button>
    </header>

    <div class="site-search-field">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.8" cy="10.8" r="5.8"></circle>
        <path d="m15.2 15.2 4.1 4.1"></path>
      </svg>
      <input
        type="search"
        placeholder="Search imagery analysis, monitoring, delivery..."
        autocomplete="off"
        spellcheck="false"
        aria-describedby="site-search-status"
        data-search-input
      />
      <kbd>ESC</kbd>
    </div>

    <div class="site-search-state" id="site-search-status" aria-live="polite" data-search-status>
      Start typing to search public MIAR content.
    </div>
    <ol class="site-search-results" aria-label="Search results" data-search-results></ol>
  </div>
</dialog>

<script>
  const dialog = document.querySelector("[data-search-dialog]");
  const openButtons = document.querySelectorAll("[data-search-open]");
  const closeButton = document.querySelector("[data-search-close]");
  const input = document.querySelector("[data-search-input]");
  const status = document.querySelector("[data-search-status]");
  const resultsList = document.querySelector("[data-search-results]");
  let searchIndex;
  let searchTimer;
  let searchSequence = 0;

  const resultType = (url) => {
    if (url.startsWith("/blogs/")) return "Analysis";
    if (url.startsWith("/solutions/")) return "Solution";
    if (url.startsWith("/capabilities/")) return "Capability";
    if (url.startsWith("/whitepapers/")) return "Whitepaper";
    if (["/legal/", "/privacy/", "/terms/"].includes(url)) return "Policy";
    return "MIAR";
  };

  const setStatus = (message) => {
    if (status) status.textContent = message;
  };

  const openSearch = () => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.showModal();
    document.body.classList.add("search-open");
    window.setTimeout(() => input instanceof HTMLInputElement && input.focus(), 0);
  };

  const closeSearch = () => {
    if (!(dialog instanceof HTMLDialogElement)) return;
    dialog.close();
    document.body.classList.remove("search-open");
  };

  const loadSearchIndex = async () => {
    if (searchIndex) return searchIndex;
    const response = await fetch("/search-index.json", { credentials: "same-origin" });
    if (!response.ok) throw new Error("Search index unavailable");
    searchIndex = await response.json();
    return searchIndex;
  };

  const normalize = (value) => value.toLocaleLowerCase().normalize("NFKD").replace(/[\u0300-\u036f]/g, "");

  const excerptFor = (entry, token) => {
    if (entry.description) return entry.description;
    const content = entry.content || "";
    const match = normalize(content).indexOf(token);
    const start = Math.max(0, match - 80);
    const excerpt = content.slice(start, start + 220).trim();
    return `${start > 0 ? "…" : ""}${excerpt}${start + 220 < content.length ? "…" : ""}`;
  };

  const searchEntries = (entries, query) => {
    const phrase = normalize(query.trim());
    const tokens = phrase.split(/\s+/).filter(Boolean);

    return entries
      .map((entry) => {
        const title = normalize(entry.title || "");
        const description = normalize(entry.description || "");
        const content = normalize(entry.content || "");
        const combined = `${title} ${description} ${content}`;
        if (!tokens.every((token) => combined.includes(token))) return null;

        let score = title.includes(phrase) ? 50 : description.includes(phrase) ? 24 : content.includes(phrase) ? 8 : 0;
        tokens.forEach((token) => {
          if (title.includes(token)) score += 14;
          if (description.includes(token)) score += 6;
          if (content.includes(token)) score += 1;
        });

        return { ...entry, score, excerpt: excerptFor(entry, tokens[0]) };
      })
      .filter(Boolean)
      .sort((a, b) => b.score - a.score || a.title.localeCompare(b.title))
      .slice(0, 8);
  };

  const appendHighlighted = (node, value, query) => {
    const terms = query.trim().split(/\s+/).filter(Boolean).map((term) => term.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"));
    if (!terms.length) {
      node.textContent = value;
      return;
    }
    const pattern = new RegExp(`(${terms.join("|")})`, "gi");
    value.split(pattern).forEach((part) => {
      if (terms.some((term) => part.toLocaleLowerCase() === term.toLocaleLowerCase())) {
        const mark = document.createElement("mark");
        mark.textContent = part;
        node.append(mark);
      } else {
        node.append(document.createTextNode(part));
      }
    });
  };

  const renderResults = (results, query = "") => {
    if (!(resultsList instanceof HTMLOListElement)) return;
    resultsList.replaceChildren();

    results.forEach((result, index) => {
      const item = document.createElement("li");
      const link = document.createElement("a");
      const meta = document.createElement("div");
      const type = document.createElement("span");
      const number = document.createElement("span");
      const title = document.createElement("strong");
      const excerpt = document.createElement("p");

      link.href = result.url;
      type.textContent = resultType(result.url);
      number.textContent = String(index + 1).padStart(2, "0");
      title.textContent = result.title || "Untitled page";
      appendHighlighted(excerpt, result.excerpt || result.description || "", query);
      meta.append(type, number);
      link.append(meta, title, excerpt);
      item.append(link);
      resultsList.append(item);
    });
  };

  const runSearch = async (query) => {
    const sequence = ++searchSequence;
    const normalizedQuery = query.trim();

    if (normalizedQuery.length < 2) {
      renderResults([]);
      setStatus("Enter at least two characters.");
      return;
    }

    setStatus("Searching...");

    try {
      const entries = await loadSearchIndex();
      const data = searchEntries(entries, normalizedQuery);
      if (sequence !== searchSequence) return;
      renderResults(data, normalizedQuery);
      setStatus(data.length ? `${data.length} result${data.length === 1 ? "" : "s"}` : `No results for “${normalizedQuery}”.`);
    } catch {
      if (sequence !== searchSequence) return;
      renderResults([]);
      setStatus("Search is unavailable in this preview. It is generated with the production build.");
    }
  };

  openButtons.forEach((button) => button.addEventListener("click", openSearch));
  closeButton?.addEventListener("click", closeSearch);
  dialog?.addEventListener("close", () => document.body.classList.remove("search-open"));
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) closeSearch();
  });

  input?.addEventListener("input", () => {
    if (!(input instanceof HTMLInputElement)) return;
    window.clearTimeout(searchTimer);
    searchTimer = window.setTimeout(() => runSearch(input.value), 160);
  });

  const warmSearch = () => loadSearchIndex().catch(() => undefined);
  if ("requestIdleCallback" in window) {
    window.requestIdleCallback(warmSearch, { timeout: 3000 });
  } else {
    window.setTimeout(warmSearch, 1500);
  }

  document.addEventListener("keydown", (event) => {
    const target = event.target;
    const isTyping = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target instanceof HTMLSelectElement || (target instanceof HTMLElement && target.isContentEditable);
    const commandSearch = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k";
    const slashSearch = event.key === "/" && !isTyping;

    if (commandSearch || slashSearch) {
      event.preventDefault();
      openSearch();
    }
  });
</script>
