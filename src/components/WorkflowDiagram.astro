---
const steps = [
  {
    title: "Register",
    tag: "Any provider",
    body: "Every new image, from any provider, is lined up with earlier images of the same place.",
    icon: `<path d="M4 11l12-6 12 6-12 6z"/><path d="M4 16l12 6 12-6"/><path d="M4 21l12 6 12-6"/>`,
  },
  {
    title: "Detect",
    tag: "Purpose-trained",
    body: "Purpose-trained models find aircraft and ships and identify their type.",
    icon: `<path d="M4 10V4h6M22 4h6v6M28 22v6h-6M10 28H4v-6"/><rect x="11" y="11" width="10" height="10"/>`,
  },
  {
    title: "Compare",
    tag: "Automatic",
    body: "Each image is compared with the last clear one to find what actually changed.",
    icon: `<rect x="4" y="7" width="15" height="15"/><rect x="13" y="11" width="15" height="15"/>`,
  },
  {
    title: "Qualify",
    tag: "Cross-checked",
    human: true,
    body: "Changes are checked across every sensor, so decoys and false alarms are caught.",
    icon: `<circle cx="16" cy="10" r="5"/><path d="M6 28c0-5.5 4.5-9 10-9s10 3.5 10 9"/><path d="M20 24l2.5 2.5L27 22"/>`,
  },
  {
    title: "Publish",
    tag: "Intelligence contract",
    body: "Confirmed changes go straight to the maps, systems and people who need them.",
    icon: `<path d="M8 4h11l6 6v18H8z"/><path d="M19 4v6h6"/><path d="M12 17h9M12 22h6"/>`,
  },
];
---

<ol class="flow" aria-label="MIAR workflow">
  {steps.map((step, index) => (
    <li class:list={["flow-step", step.human && "is-human"]}>
      <div class="flow-rail" aria-hidden="true">
        <span class="flow-icon"><svg viewBox="0 0 32 32" set:html={step.icon} /></span>
      </div>
      <span class="num">0{index + 1}</span>
      <h3>{step.title}</h3>
      <p>{step.body}</p>
      <span class="flow-tag">{step.tag}</span>
    </li>
  ))}
</ol>
