---
// Operating modes for the same pass. Heightened awareness joins the detection to a
// platform capability library and assesses it against protected assets.
// All variants are rendered on the server; the script only switches between them.
import { PLATFORMS, ASSETS, OBSERVED, assessThreat } from "../lib/threat-model.mjs";

const detection = { id: "D-2291", count: 4, delta: 4, confidence: 0.88 };
const platformOrder = ["fighter", "transport", "tanker", "aew"] as const;
const signals = platformOrder.map((id) => ({ id, signal: assessThreat(id, detection) }));

const modes = [
  { id: "detect", name: "Detect", when: "Every pass" },
  { id: "monitor", name: "Monitor", when: "Watchlist sites" },
  { id: "aware", name: "Heightened awareness", when: "Tension or crisis" },
  { id: "audit", name: "Audit", when: "Assurance and review" },
  { id: "report", name: "Report", when: "Daily or on demand" },
];

// Schematic map: 0.9 px per km, observed base on the left.
const scale = 0.9;
const origin = { x: 72, y: 190 };
const px = (p: { x: number; y: number }) => ({ x: origin.x + p.x * scale, y: origin.y - p.y * scale });
const base = px(OBSERVED);
const borderX = origin.x + 42 * scale;
const levelClass = (level: string) => `lvl-${level.toLowerCase()}`;
---

<div class="modes" data-modes data-mode="aware" data-platform="fighter">
  <div class="modes-tabs" role="tablist" aria-label="Operating mode">
    {modes.map((mode) => (
      <button type="button" role="tab" data-mode-tab={mode.id} aria-selected={mode.id === "aware" ? "true" : "false"}>
        <strong>{mode.name}</strong>
        <span>{mode.when}</span>
      </button>
    ))}
  </div>

  <!-- Detect -->
  <section class="modes-panel" data-mode-panel="detect" hidden>
    <p class="modes-lede">Find and classify every object on the received scene, with a confidence for each call.</p>
    <table class="modes-table">
      <thead><tr><th>Detection</th><th>Object</th><th>Count</th><th>Confidence</th></tr></thead>
      <tbody>
        <tr><td class="mono">D-2291</td><td>Fighter · F-16 family</td><td class="mono">4</td><td class="mono">0.88</td></tr>
        <tr><td class="mono">D-2292</td><td>Transport · C-130 family</td><td class="mono">1</td><td class="mono">0.91</td></tr>
        <tr><td class="mono">D-2293</td><td>Fuel bowser cluster</td><td class="mono">6</td><td class="mono">0.79</td></tr>
        <tr><td class="mono">D-2294</td><td>Shelter doors open</td><td class="mono">3</td><td class="mono">0.83</td></tr>
      </tbody>
    </table>
  </section>

  <!-- Monitor -->
  <section class="modes-panel" data-mode-panel="monitor" hidden>
    <p class="modes-lede">Compare against the last usable scene and the ORBAT, and flag what changed.</p>
    <ul class="modes-changes">
      <li class="is-up"><span class="mono">+4</span><div><strong>Fighter-family aircraft on the apron</strong><p>Against 2 in the last usable scene. Exceeds the site's 90-day norm.</p></div></li>
      <li class="is-up"><span class="mono">+3</span><div><strong>Hardened shelters open</strong><p>Consistent with preparation rather than routine maintenance.</p></div></li>
      <li><span class="mono">±0</span><div><strong>Transport presence unchanged</strong><p>One C-130-family aircraft, same stand as baseline.</p></div></li>
      <li class="is-up"><span class="mono">+6</span><div><strong>Fuel bowsers near the apron</strong><p>New since the last usable scene.</p></div></li>
    </ul>
  </section>

  <!-- Heightened awareness -->
  <section class="modes-panel" data-mode-panel="aware">
    <p class="modes-lede">
      Join the detection to the platform's established capability and the dynamic ORBAT, then assess it
      against the assets you protect. Choose the platform MIAR identified at the same base:
    </p>
    <div class="aware-switch" role="group" aria-label="Detected platform">
      {platformOrder.map((id) => (
        <button type="button" data-platform-pick={id} aria-pressed={id === "fighter" ? "true" : "false"}>
          <strong>{PLATFORMS[id].family}</strong>
          <span>{PLATFORMS[id].role}</span>
        </button>
      ))}
    </div>

    <div class="aware-grid">
      <figure class="aware-map">
        <svg viewBox="0 0 640 380" role="img" aria-label="Schematic map: the observed border airbase on the left, protected assets to the east, and the reach of the detected platform drawn as a ring.">
          <defs>
            <pattern id="aware-grid" width="36" height="36" patternUnits="userSpaceOnUse">
              <path d="M36 0H0V36" fill="none" stroke="rgba(242,241,236,0.06)" />
            </pattern>
            <clipPath id="aware-clip"><rect width="640" height="380" /></clipPath>
          </defs>
          <rect width="640" height="380" fill="url(#aware-grid)" />
          <g clip-path="url(#aware-clip)">
            {signals.map(({ id, signal }) => (
              <g class="aware-layer" data-platform-layer={id}>
                {id === "tanker" && (
                  <circle class="ring ring-inner" cx={base.x} cy={base.y} r={PLATFORMS.fighter.radiusKm * scale} />
                )}
                {signal.reach && (
                  <circle class:list={["ring", `ring-${id}`]} cx={base.x} cy={base.y} r={signal.reach * scale} />
                )}
                {signal.inRange.map((asset) => {
                  const p = px(asset);
                  return <circle class="halo" cx={p.x} cy={p.y} r="15" />;
                })}
                {id === "transport" && (
                  <path class="movement" d={`M${base.x + 16} ${base.y}C${base.x + 60} ${base.y - 30} ${borderX - 10} ${base.y - 34} ${borderX + 6} ${base.y - 12}`} />
                )}
              </g>
            ))}
          </g>

          <line class="border" x1={borderX} y1="10" x2={borderX} y2="370" />
          <text class="map-k" x={borderX - 8} y="26" text-anchor="end">OBSERVED</text>
          <text class="map-k" x={borderX + 8} y="26">PROTECTED</text>

          <g class="base">
            <rect x={base.x - 9} y={base.y - 9} width="18" height="18" />
            <text class="map-name" x={base.x - 12} y={base.y - 34}>{OBSERVED.name}</text>
            <text class="map-sub" x={base.x - 12} y={base.y - 20}>D-2291 · +4 detected</text>
          </g>

          {ASSETS.map((asset) => {
            const p = px(asset);
            const flip = p.x > 500;
            const tx = flip ? p.x - 12 : p.x + 12;
            const anchor = flip ? "end" : "start";
            return (
              <g class="asset" data-asset={asset.id}>
                <path d={`M${p.x} ${p.y - 7}L${p.x + 7} ${p.y}L${p.x} ${p.y + 7}L${p.x - 7} ${p.y}Z`} />
                <text class="map-name" x={tx} y={p.y - 6} text-anchor={anchor}>{asset.name}</text>
                <text class="map-sub" x={tx} y={p.y + 8} text-anchor={anchor}>{asset.kind} · {Math.round(Math.hypot(asset.x, asset.y))} km</text>
              </g>
            );
          })}
        </svg>
        <figcaption>Schematic. Placeholder installations; capability figures are rounded open-source reference values.</figcaption>
      </figure>

      <div class="aware-cards">
        {signals.map(({ id, signal }) => (
          <article class:list={["signal", levelClass(signal.level)]} data-platform-card={id} hidden={id !== "fighter"}>
            <header>
              <span class="signal-level">{signal.level}</span>
              <span class="mono">Threat signal · T-{id === "fighter" ? "0317" : id === "transport" ? "0318" : id === "tanker" ? "0319" : "0320"}</span>
            </header>
            <h3>{signal.headline}</h3>
            <dl>
              <div><dt>Detected platform</dt><dd>{detection.count} × {signal.platform.family} · {signal.platform.role.toLowerCase()} · confidence {detection.confidence.toFixed(2)}</dd></div>
              <div><dt>Established capability</dt><dd>{signal.platform.capability}. {signal.platform.radiusLabel}.</dd></div>
              <div><dt>Threat assessment</dt><dd><strong>{signal.posture}.</strong> {signal.inRange.length ? `${signal.inRange.length} protected ${signal.inRange.length === 1 ? "asset" : "assets"} within reach.` : "No protected asset within reach."}</dd></div>
            </dl>
            <div class="signal-why">
              <span>Because</span>
              <ol>{signal.reasons.map((reason) => <li>{reason}</li>)}</ol>
            </div>
            <div class="signal-actions">
              <span>Recommended</span>
              <ul>{signal.actions.map((action) => <li>{action}</li>)}</ul>
            </div>
            <footer>
              <p class="signal-state" data-signal-state>Awaiting analyst qualification</p>
              <div>
                <button type="button" class="is-primary" data-signal-decide="qualify">Qualify signal</button>
                <button type="button" data-signal-decide="dismiss">Dismiss</button>
              </div>
            </footer>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Audit -->
  <section class="modes-panel" data-mode-panel="audit" hidden>
    <p class="modes-lede">Reproduce any finding from exactly what produced it, for review, assurance or a partner who needs to check.</p>
    <ol class="modes-chain">
      <li><span class="mono">SCN-0642Z</span><strong>Source scene</strong><p>EO, 0.5 m GSD, look angle 14°, checksum recorded</p></li>
      <li><span class="mono">REG · 0.4 px</span><strong>Co-registration</strong><p>Against last usable scene SCN-0618Z</p></li>
      <li><span class="mono">DET v3.2</span><strong>Detector version</strong><p>Aircraft model, oriented boxes, class → family → type</p></li>
      <li><span class="mono">CAP-LIB 2026.3</span><strong>Capability library</strong><p>Reference values used in the threat assessment</p></li>
      <li><span class="mono">ANL-07</span><strong>Analyst decision</strong><p>Qualified 09:18Z with note</p></li>
      <li><span class="mono">F-0152</span><strong>Published contract</strong><p>Disseminated to the operational picture 09:20Z</p></li>
    </ol>
  </section>

  <!-- Report -->
  <section class="modes-panel" data-mode-panel="report" hidden>
    <p class="modes-lede">Compile qualified findings into a site intelligence summary, ready to brief.</p>
    <pre class="modes-report">SITE INTELLIGENCE SUMMARY · BORDER AIRBASE B · 27 SEP 06:42Z

1. SUMMARY  Fighter presence rose from 2 to 6 (F-16 family). Three
   hardened shelters open; fuel bowsers staged near the apron.
2. ASSESSMENT  Offensive air posture. Forward Air Station K and
   Radar Site T lie inside combat radius. Threat level: HIGH.
3. CONFIDENCE  Detection 0.88 · qualified by analyst 07.
4. COLLECTION  SAR revisit requested within 12 h.
5. SOURCES  SCN-0642Z (EO), SCN-0210Z (SAR) · contract F-0152</pre>
  </section>
</div>

<style>
  .modes {
    border: 1px solid var(--ink);
    background: var(--night);
    color: var(--on-night);
  }

  .modes-tabs {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    border-bottom: 1px solid var(--night-rule);
  }

  .modes-tabs button {
    display: grid;
    gap: 3px;
    padding: 14px 16px;
    border: 0;
    border-right: 1px solid var(--night-rule);
    background: transparent;
    color: var(--on-night-2);
    text-align: left;
    transition: background 0.2s var(--ease), color 0.2s var(--ease);
  }

  .modes-tabs button:last-child {
    border-right: 0;
  }

  .modes-tabs button strong {
    font-size: 15px;
    font-weight: 500;
  }

  .modes-tabs button span {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--on-night-3);
  }

  .modes-tabs button:hover {
    color: var(--on-night);
  }

  .modes-tabs button[aria-selected="true"] {
    background: var(--on-night);
    color: var(--night);
  }

  .modes-tabs button[aria-selected="true"] span {
    color: #b8400f;
  }

  .modes-panel {
    padding: 22px;
    display: grid;
    gap: 18px;
  }

  .modes-lede {
    max-width: 760px;
    font-size: 15.5px;
    color: var(--on-night-2);
  }

  .mono {
    font-family: var(--mono);
    font-variant-numeric: tabular-nums;
  }

  /* Detect */
  .modes-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14.5px;
  }

  .modes-table th,
  .modes-table td {
    padding: 12px 10px;
    text-align: left;
    border-bottom: 1px solid var(--night-rule);
  }

  .modes-table th {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--on-night-3);
  }

  /* Monitor */
  .modes-changes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--night-rule);
    border: 1px solid var(--night-rule);
  }

  .modes-changes li {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 12px;
    padding: 16px;
    background: var(--night);
  }

  .modes-changes li > span {
    font-size: 20px;
    color: var(--on-night-2);
  }

  .modes-changes li.is-up > span {
    color: var(--signal);
  }

  .modes-changes strong {
    font-weight: 500;
  }

  .modes-changes p {
    margin-top: 2px;
    font-size: 14px;
    color: var(--on-night-2);
  }

  /* Heightened awareness */
  .aware-switch {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 6px;
  }

  .aware-switch button {
    display: grid;
    gap: 2px;
    padding: 10px 12px;
    border: 1px solid var(--night-rule);
    background: transparent;
    color: var(--on-night);
    text-align: left;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }

  .aware-switch button span {
    font-size: 12.5px;
    color: var(--on-night-3);
  }

  .aware-switch button:hover {
    border-color: var(--on-night-3);
  }

  .aware-switch button[aria-pressed="true"] {
    border-color: var(--signal);
    background: rgba(228, 87, 30, 0.12);
  }

  .aware-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 18px;
    align-items: start;
  }

  .aware-map {
    margin: 0;
    border: 1px solid var(--night-rule);
    background: var(--night-2);
  }

  .aware-map svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .aware-map figcaption {
    padding: 8px 12px;
    border-top: 1px solid var(--night-rule);
    font-size: 12px;
    color: var(--on-night-3);
  }

  .aware-layer {
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }

  [data-platform="fighter"] [data-platform-layer="fighter"],
  [data-platform="transport"] [data-platform-layer="transport"],
  [data-platform="tanker"] [data-platform-layer="tanker"],
  [data-platform="aew"] [data-platform-layer="aew"] {
    opacity: 1;
  }

  .ring {
    fill: rgba(228, 87, 30, 0.07);
    stroke: #e4571e;
    stroke-width: 1.5;
    stroke-dasharray: 6 5;
  }

  .ring-inner {
    fill: none;
    stroke: rgba(242, 241, 236, 0.35);
  }

  .ring-aew {
    fill: rgba(95, 211, 176, 0.06);
    stroke: #5fd3b0;
  }

  .halo {
    fill: none;
    stroke: #e4571e;
    stroke-width: 1.5;
    animation: halo 2.2s var(--ease) infinite;
    transform-box: fill-box;
    transform-origin: center;
  }

  [data-platform-layer="aew"] .halo {
    stroke: #5fd3b0;
  }

  @keyframes halo {
    0% {
      transform: scale(0.7);
      opacity: 1;
    }
    100% {
      transform: scale(1.6);
      opacity: 0;
    }
  }

  .movement {
    fill: none;
    stroke: var(--on-night-2);
    stroke-width: 1.5;
    stroke-dasharray: 4 5;
    marker-end: none;
    animation: move 1.4s linear infinite;
  }

  @keyframes move {
    to {
      stroke-dashoffset: -18;
    }
  }

  .border {
    stroke: rgba(242, 241, 236, 0.4);
    stroke-dasharray: 2 6;
  }

  .map-k {
    fill: var(--on-night-3);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.08em;
  }

  .base rect {
    fill: #e4571e;
  }

  .asset path {
    fill: var(--night);
    stroke: var(--on-night);
    stroke-width: 1.5;
  }

  .map-name {
    fill: var(--on-night);
    font-family: var(--sans);
    font-size: 12.5px;
    font-weight: 500;
  }

  .map-sub {
    fill: var(--on-night-3);
    font-family: var(--mono);
    font-size: 10px;
  }

  .signal {
    display: grid;
    gap: 14px;
    padding: 18px;
    border: 1px solid var(--night-rule);
    border-top: 3px solid var(--on-night-3);
    background: var(--night-2);
  }

  .signal.lvl-high {
    border-top-color: #e4571e;
  }

  .signal.lvl-elevated {
    border-top-color: #e3a13a;
  }

  .signal.lvl-watch {
    border-top-color: #5fd3b0;
  }

  .signal header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    color: var(--on-night-3);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .signal-level {
    padding: 3px 8px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #0b0e10;
    background: var(--on-night-3);
  }

  .lvl-high .signal-level {
    background: #e4571e;
    color: #fff;
  }

  .lvl-elevated .signal-level {
    background: #e3a13a;
  }

  .lvl-watch .signal-level {
    background: #5fd3b0;
  }

  .signal h3 {
    font-size: 1.1rem;
    line-height: 1.3;
  }

  .signal dl {
    display: grid;
    gap: 10px;
  }

  .signal dl div {
    display: grid;
    gap: 2px;
  }

  .signal dt,
  .signal-why > span,
  .signal-actions > span {
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--on-night-3);
  }

  .signal dd {
    font-size: 14px;
    color: var(--on-night);
  }

  .signal dd strong {
    font-weight: 500;
  }

  .signal-why,
  .signal-actions {
    display: grid;
    gap: 6px;
  }

  .signal-why ol,
  .signal-actions ul {
    display: grid;
    gap: 4px;
    padding-left: 18px;
    font-size: 13.5px;
    color: var(--on-night-2);
  }

  .signal-why ol {
    list-style: decimal;
  }

  .signal-actions ul {
    list-style: square;
  }

  .signal footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding-top: 12px;
    border-top: 1px solid var(--night-rule);
  }

  .signal-state {
    font-family: var(--mono);
    font-size: 11.5px;
    color: #e3a13a;
  }

  .signal-state.is-done {
    color: #5fd3b0;
  }

  .signal footer div {
    display: flex;
    gap: 6px;
  }

  .signal footer button {
    min-height: 34px;
    padding: 0 12px;
    border: 1px solid var(--night-rule);
    background: transparent;
    color: var(--on-night);
    font-size: 13.5px;
  }

  .signal footer .is-primary {
    background: var(--on-night);
    border-color: var(--on-night);
    color: var(--night);
    font-weight: 500;
  }

  /* Audit */
  .modes-chain {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--night-rule);
    border: 1px solid var(--night-rule);
    counter-reset: chain;
  }

  .modes-chain li {
    display: grid;
    gap: 4px;
    padding: 16px;
    background: var(--night);
  }

  .modes-chain span {
    font-size: 11.5px;
    color: var(--signal);
  }

  .modes-chain strong {
    font-weight: 500;
  }

  .modes-chain p {
    font-size: 13.5px;
    color: var(--on-night-2);
  }

  /* Report */
  .modes-report {
    margin: 0;
    padding: 18px;
    overflow-x: auto;
    border: 1px solid var(--night-rule);
    background: var(--night-2);
    font-family: var(--mono);
    font-size: 12.5px;
    line-height: 1.7;
    color: var(--on-night-2);
  }

  @media (max-width: 1000px) {
    .modes-tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .modes-tabs button:nth-child(3) {
      border-right: 0;
    }

    .modes-tabs button:nth-child(n + 4) {
      border-top: 1px solid var(--night-rule);
    }

    .aware-grid {
      grid-template-columns: 1fr;
    }

    .modes-chain {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 620px) {
    .modes-tabs {
      grid-template-columns: 1fr 1fr;
    }

    .modes-tabs button {
      border-right: 1px solid var(--night-rule);
      border-top: 1px solid var(--night-rule);
    }

    .aware-switch,
    .modes-changes,
    .modes-chain {
      grid-template-columns: 1fr 1fr;
    }

    .modes-changes,
    .modes-chain {
      grid-template-columns: 1fr;
    }

    .modes-panel {
      padding: 16px;
    }

    .modes-table th:nth-child(1),
    .modes-table td:nth-child(1) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .halo,
    .movement {
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-modes]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-mode-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-mode-panel]")];
    const picks = [...root.querySelectorAll<HTMLButtonElement>("[data-platform-pick]")];
    const cards = [...root.querySelectorAll<HTMLElement>("[data-platform-card]")];

    const showMode = (id: string) => {
      root.dataset.mode = id;
      tabs.forEach((tab) => tab.setAttribute("aria-selected", String(tab.dataset.modeTab === id)));
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.modePanel !== id;
      });
    };

    const showPlatform = (id: string) => {
      root.dataset.platform = id;
      picks.forEach((pick) => pick.setAttribute("aria-pressed", String(pick.dataset.platformPick === id)));
      cards.forEach((card) => {
        card.hidden = card.dataset.platformCard !== id;
      });
    };

    tabs.forEach((tab) => tab.addEventListener("click", () => showMode(tab.dataset.modeTab ?? "aware")));
    picks.forEach((pick) => pick.addEventListener("click", () => showPlatform(pick.dataset.platformPick ?? "fighter")));

    cards.forEach((card) => {
      const state = card.querySelector<HTMLElement>("[data-signal-state]");
      card.querySelectorAll<HTMLButtonElement>("[data-signal-decide]").forEach((button) => {
        button.addEventListener("click", () => {
          if (!state) return;
          const now = new Date();
          const time = `${String(now.getUTCHours()).padStart(2, "0")}:${String(now.getUTCMinutes()).padStart(2, "0")}Z`;
          state.textContent =
            button.dataset.signalDecide === "qualify"
              ? `Qualified by you · ${time} · published to the operational picture`
              : `Dismissed by you · ${time} · reason logged`;
          state.classList.add("is-done");
        });
      });
    });
  });
</script>
