---
interface Props {
  id?: string;
  summary?: boolean;
}

const { id = "compare", summary = true } = Astro.props;

// Shared coordinate space: the 2025 reference image (1564 × 1136).
// The 2026 follow-on image is registered by offsetting it 78px down.
const view = { x: 300, y: 400, w: 1180, h: 580 };
const followOnOffsetY = 78;

const bracket = (cx: number, cy: number, size = 96, c = 14) => {
  const x = cx - size / 2;
  const y = cy - size / 2;
  return `M${x} ${y + c}V${y}H${x + c}M${x + size - c} ${y}H${x + size}V${y + c}M${x + size} ${y + size - c}V${y + size}H${x + size - c}M${x + c} ${y + size}H${x}V${y + size - c}`;
};

const baseline = [
  { x: 595, y: 595, state: "vacated" },
  { x: 708, y: 598, state: "vacated" },
  { x: 985, y: 528, state: "held" },
  { x: 1095, y: 533, state: "held" },
  { x: 955, y: 732, state: "held" },
  { x: 1075, y: 735, state: "vacated" },
];

const current = [
  { x: 492, y: 590, state: "new", label: "NEW POSITION" },
  { x: 982, y: 528, state: "held" },
  { x: 1090, y: 533, state: "held" },
  { x: 1355, y: 600, state: "new", label: "NEW POSITION" },
  { x: 955, y: 733, state: "held" },
  { x: 725, y: 918, state: "new", label: "ON TAXIWAY" },
  { x: 982, y: 846, state: "new", label: "ROTARY-WING", size: 70 },
];

const labelWidth = (text: string) => text.length * 10.2 + 18;
const start = 50;
const divider = view.x + (view.w * start) / 100;
---

<div class:list={["compare", !summary && "compare-solo"]} data-compare>
  <figure class="compare-figure">
    <div class="compare-frame" data-compare-frame>
      <svg
        viewBox={`${view.x} ${view.y} ${view.w} ${view.h}`}
        role="img" aria-label="The same airbase apron in 2025 and 2026. Six aircraft appear in both images, but three are in new positions, three earlier stands are empty, and a rotary-wing aircraft has arrived.">
        <defs>
          <clipPath id={`${id}-before`}>
            <rect data-clip-before x={view.x} y={view.y} width={divider - view.x} height={view.h} />
          </clipPath>
          <clipPath id={`${id}-after`}>
            <rect data-clip-after x={divider} y={view.y} width={view.x + view.w - divider} height={view.h} />
          </clipPath>
        </defs>

        <g clip-path={`url(#${id}-after)`}>
          <image href="/imagery/monitored-site-follow-on-2026.webp" x="2" y={followOnOffsetY} width="1546" height="1090" />
          <rect x={view.x} y={view.y} width={view.w} height={view.h} opacity="0.18" style="fill: var(--panel)" />
          {current.map((mark) => (
            <g>
              <path class:list={["mark-box", mark.state === "new" && "is-change"]} d={bracket(mark.x, mark.y, mark.size)} />
              {mark.label && (
                <g class="mark-tag is-change" transform={`translate(${mark.x - (mark.size ?? 96) / 2} ${mark.y - (mark.size ?? 96) / 2 - 30})`}>
                  <rect width={labelWidth(mark.label)} height="26" />
                  <text x="9" y="18" style="font-size: 16px">{mark.label}</text>
                </g>
              )}
            </g>
          ))}
          <g class="compare-stamp" transform={`translate(${view.x + view.w - 250} ${view.y + 20})`}>
            <rect width="230" height="34" />
            <text x="14" y="23">2026 · CURRENT</text>
          </g>
        </g>

        <g clip-path={`url(#${id}-before)`}>
          <image href="/imagery/monitored-site-reference-2025.webp" x="0" y="0" width="1564" height="1136" />
          <rect x={view.x} y={view.y} width={view.w} height={view.h} opacity="0.18" style="fill: var(--panel)" />
          {baseline.map((mark) => (
            <path class:list={["mark-box", mark.state === "vacated" && "is-vacated"]} d={bracket(mark.x, mark.y)} />
          ))}
          <g class="compare-stamp" transform={`translate(${view.x + 20} ${view.y + 20})`}>
            <rect width="236" height="34" />
            <text x="14" y="23">2025 · BASELINE</text>
          </g>
        </g>

        <g data-compare-handle transform={`translate(${divider} 0)`}>
          <line class="compare-divider" x1="0" x2="0" y1={view.y} y2={view.y + view.h} />
          <g class="compare-knob" transform={`translate(0 ${view.y + view.h / 2})`}>
            <circle r="26" />
            <path d="M-8 -8 L-15 0 L-8 8 M8 -8 L15 0 L8 8" />
          </g>
        </g>
      </svg>
    </div>
    <div class="compare-controls">
      <span>2025</span>
      <input
        class="compare-range"
        type="range"
        min="0"
        max="100"
        value={start}
        step="0.5"
        aria-label="Drag to compare the 2025 baseline with the 2026 image"
        data-compare-range
      />
      <span>2026</span>
    </div>
  </figure>

  {summary && (
    <aside class="compare-summary" aria-label="Change summary">
      <div class="label">Change summary</div>
      <div class="compare-count">
        <div>
          <span>2025</span>
          <strong>6</strong>
        </div>
        <i aria-hidden="true"></i>
        <div>
          <span>2026</span>
          <strong>6</strong>
        </div>
      </div>
      <ul class="compare-list">
        <li><i class="key" aria-hidden="true"></i>Stand occupied in both<strong>3</strong></li>
        <li><i class="key key-change" aria-hidden="true"></i>Aircraft in new position<strong>3</strong></li>
        <li><i class="key key-vacated" aria-hidden="true"></i>Stand vacated<strong>3</strong></li>
        <li><i class="key key-dot" aria-hidden="true"></i>Rotary-wing arrived<strong>+1</strong></li>
      </ul>
      <div class="compare-status">
        <span>Flagged for analyst review</span>
        Count unchanged. Layout changed.
      </div>
    </aside>
  )}
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-compare]").forEach((root) => {
    const frame = root.querySelector<HTMLElement>("[data-compare-frame]");
    const svg = frame?.querySelector("svg");
    const range = root.querySelector<HTMLInputElement>("[data-compare-range]");
    const before = root.querySelector<SVGRectElement>("[data-clip-before]");
    const after = root.querySelector<SVGRectElement>("[data-clip-after]");
    const handle = root.querySelector<SVGGElement>("[data-compare-handle]");
    if (!frame || !svg || !range || !before || !after || !handle) return;

    const box = svg.viewBox.baseVal;

    const render = (percent: number) => {
      const value = Math.min(100, Math.max(0, percent));
      const x = box.x + (box.width * value) / 100;
      before.setAttribute("width", String(x - box.x));
      after.setAttribute("x", String(x));
      after.setAttribute("width", String(box.x + box.width - x));
      handle.setAttribute("transform", `translate(${x} 0)`);
      range.value = String(value);
    };

    const fromPointer = (event: PointerEvent) => {
      const rect = svg.getBoundingClientRect();
      render(((event.clientX - rect.left) / rect.width) * 100);
    };

    let dragging = false;
    let touched = false;
    frame.addEventListener("pointerdown", (event) => {
      dragging = true;
      touched = true;
      frame.setPointerCapture(event.pointerId);
      fromPointer(event);
    });
    frame.addEventListener("pointermove", (event) => {
      if (dragging) fromPointer(event);
    });
    const stop = () => {
      dragging = false;
    };
    frame.addEventListener("pointerup", stop);
    frame.addEventListener("pointercancel", stop);
    range.addEventListener("input", () => {
      touched = true;
      render(Number(range.value));
    });

    // One gentle sweep the first time the figure scrolls into view, to show it is interactive.
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduced || !("IntersectionObserver" in window)) return;
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        const started = performance.now();
        const sweep = (now: number) => {
          if (touched) return;
          const t = Math.min(1, (now - started) / 1800);
          render(50 + Math.sin(t * Math.PI * 2) * 22 * (1 - t));
          if (t < 1) requestAnimationFrame(sweep);
        };
        requestAnimationFrame(sweep);
      },
      { threshold: 0.6 }
    );
    observer.observe(frame);
  });
</script>
